<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinExe: no console window, ever. -->
    <OutputType>WinExe</OutputType>
    <AssemblyName>MyRGB</AssemblyName>
    <RootNamespace>MyRGB.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- The brand theme stays in branding/ so the kit is its single source. -->
    <AvaloniaXaml Include="..\..\branding\Theme.axaml" Link="Theme.axaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyRGB.Core\MyRGB.Core.csproj" />
    <ProjectReference Include="..\MyRGB.Providers.OpenRgb\MyRGB.Providers.OpenRgb.csproj" />
    <ProjectReference Include="..\MyRGB.Providers.Corsair\MyRGB.Providers.Corsair.csproj" />
    <ProjectReference Include="..\MyRGB.Api\MyRGB.Api.csproj" />
    <ProjectReference Include="..\MyRGB.Battery\MyRGB.Battery.csproj" />
    <ProjectReference Include="..\MyRGB.Cloud\MyRGB.Cloud.csproj" />
    <ProjectReference Include="..\MyRGB.Sensors\MyRGB.Sensors.csproj" />
    <ProjectReference Include="..\MyRGB.Audio\MyRGB.Audio.csproj" />
    <!-- Build-order only: the helper's files are staged into helper\ below, not referenced. -->
    <ProjectReference Include="..\MyRGB.Sensors.Helper\MyRGB.Sensors.Helper.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one-prompt setup script the Cooling page runs; the installer bundles the same file. -->
    <Content Include="..\..\tools\setup-openrgb-admin.ps1" Link="setup\setup-openrgb-admin.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Dev builds carry the helper in helper\ so the Cooling page's enable flow works without the installer.
       The whole output tree, deps.json included: the runtime finds LibreHardwareMonitorLib through it. -->
  <Target Name="StageSensorHelper" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <PropertyGroup>
      <HelperOut>$(MSBuildThisFileDirectory)..\MyRGB.Sensors.Helper\bin\$(Configuration)\net10.0</HelperOut>
    </PropertyGroup>
    <ItemGroup>
      <HelperFiles Include="$(HelperOut)\**\*.*" Exclude="$(HelperOut)\**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(HelperFiles)"
          DestinationFiles="@(HelperFiles->'$(OutDir)helper\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
