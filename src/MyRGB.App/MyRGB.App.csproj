<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinExe: no console window, ever. -->
    <OutputType>WinExe</OutputType>
    <AssemblyName>MyRGB</AssemblyName>
    <RootNamespace>MyRGB.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyRGB.Core\MyRGB.Core.csproj" />
    <ProjectReference Include="..\MyRGB.Providers.OpenRgb\MyRGB.Providers.OpenRgb.csproj" />
    <ProjectReference Include="..\MyRGB.Providers.Corsair\MyRGB.Providers.Corsair.csproj" />
    <ProjectReference Include="..\MyRGB.Api\MyRGB.Api.csproj" />
    <ProjectReference Include="..\MyRGB.Battery\MyRGB.Battery.csproj" />
    <ProjectReference Include="..\MyRGB.Cloud\MyRGB.Cloud.csproj" />
  </ItemGroup>
</Project>
