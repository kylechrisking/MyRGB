<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MyRGB.App.App"
             Name="MyRGB"
             RequestedThemeVariant="Light">
    <Application.Resources>
        <ResourceDictionary>
            <!-- The theme's tokens. ThemeManager swaps this for the theme picked in Settings;
                 Notebook is here so the designer and the first frame have something. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://MyRGB/Themes/Notebook.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#56DB8F" RegionColor="#071117" />
                <ColorPaletteResources x:Key="Light" Accent="#2F5FC4" RegionColor="#F1EBDD" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <!-- Every theme's base styles; a theme's own Styles file is added after this by ThemeManager. -->
        <StyleInclude Source="avares://MyRGB/Themes/Shared.axaml" />
    </Application.Styles>
</Application>
