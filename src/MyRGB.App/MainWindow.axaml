<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyRGB.App.ViewModels"
        xmlns:ctl="using:MyRGB.App.Controls"
        xmlns:svc="using:MyRGB.App.Services"
        xmlns:l="using:MyRGB.App.Localization"
        xmlns:presets="using:MyRGB.Core.Presets"
        xmlns:sensors="using:MyRGB.Core.Sensors"
        x:Class="MyRGB.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="MyRGB"
        Icon="/Assets/icon.ico"
        Width="1240" Height="800" MinWidth="960" MinHeight="620">

  <Grid>
    <DockPanel>
      <!-- Top bar: brand, now-playing chip, global controls -->
      <Border DockPanel.Dock="Top" Classes="topbar">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Image Source="/Assets/mark.png" Width="30" Height="30" IsVisible="{DynamicResource MarkVisible}" />
            <TextBlock Classes="wordmark" VerticalAlignment="Center">
              <Run Text="My" /><Run Text="R" Foreground="{DynamicResource LedRedBrush}" /><Run Text="G" Foreground="{DynamicResource LedGreenBrush}" /><Run Text="B" Foreground="{DynamicResource LedBlueBrush}" />
            </TextBlock>
          </StackPanel>

          <Button Grid.Column="2" Classes="ghost" Command="{Binding OpenTourCommand}" Margin="0,0,22,0" VerticalAlignment="Center"
                  ToolTip.Tip="{l:Tr top.tourTip}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{x:Static ctl:NavIcons.Help}" Width="14" Height="14" />
              <TextBlock Text="{l:Tr top.howItWorks}" />
            </StackPanel>
          </Button>
          <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowMonitorSlider}" ToolTip.Tip="{l:Tr top.screensTip}">
              <TextBlock Classes="muted" Text="{Binding MonitorLevel, Converter={x:Static l:Tr.Format}, ConverterParameter=top.screens}" VerticalAlignment="Center" Margin="0,0,10,0" />
              <Slider Width="110" Minimum="0" Maximum="100" Value="{Binding MonitorLevel}" VerticalAlignment="Center" Margin="0,0,22,0" />
            </StackPanel>
            <TextBlock Classes="muted" Text="{Binding Brightness, Converter={x:Static l:Tr.Format}, ConverterParameter=top.brightness}" VerticalAlignment="Center" Margin="0,0,10,0" />
          </StackPanel>
          <Slider Grid.Column="5" Width="150" Minimum="0" Maximum="100" Value="{Binding Brightness}" VerticalAlignment="Center" Margin="0,0,22,0" />
          <ctl:Switch Grid.Column="6" IsChecked="{Binding Enabled}" OnContent="{l:Tr top.lightsOn}" OffContent="{l:Tr top.lightsOff}" VerticalAlignment="Center" />
          <Button Grid.Column="7" Classes="ghost" Command="{Binding NavigateCommand}" CommandParameter="account" Margin="18,0,0,0"
                  VerticalAlignment="Center" IsVisible="{Binding CloudAvailable}" Padding="6,5,12,5" CornerRadius="{DynamicResource RadiusPill}"
                  ToolTip.Tip="{l:Tr top.accountTip}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Classes="avatar" Width="24" Height="24">
                <TextBlock Text="{Binding Account.Initial}" FontSize="12" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Account.IsSignedIn}" />
              </Border>
              <TextBlock Text="{Binding Account.DisplayName}" VerticalAlignment="Center" IsVisible="{Binding Account.IsSignedIn}"
                         MaxWidth="120" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{l:Tr top.signIn}" VerticalAlignment="Center" IsVisible="{Binding !Account.IsSignedIn}" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <!-- Update strip: a newer release is out, one click installs it -->
      <Border DockPanel.Dock="Top" IsVisible="{Binding Update.ShowStrip}" Classes="updatestrip">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <PathIcon Data="{x:Static ctl:NavIcons.Download}" Width="17" Height="17" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="{Binding Update.Available.Version, Converter={x:Static l:Tr.Format}, ConverterParameter=update.available}" VerticalAlignment="Center" FontWeight="SemiBold" />
            <ProgressBar Classes="meter" Width="150" Maximum="1" Value="{Binding Update.Progress}" IsVisible="{Binding Update.Busy}" VerticalAlignment="Center" />
            <TextBlock Classes="muted" Text="{Binding Update.Status}" VerticalAlignment="Center"
                       IsVisible="{Binding Update.Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding !Update.Busy}">
            <Button Classes="accent" Content="{l:Tr update.install}" Command="{Binding Update.InstallCommand}" />
            <Button Classes="ghost" Content="{l:Tr update.whatsNew}" Command="{Binding Update.OpenNotesCommand}" />
            <Button Classes="link" Content="{l:Tr update.dismiss}" Command="{Binding Update.DismissCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <TabControl Classes="nav" TabStripPlacement="Left" SelectedIndex="{Binding SelectedTab}" Padding="0">

        <!-- ===== Home ===== -->
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="{x:Static ctl:NavIcons.Home}" />
              <TextBlock Text="Home" VerticalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
          <ScrollViewer>
            <StackPanel Spacing="24" Margin="0,0,8,8">
              <StackPanel Spacing="4">
                <TextBlock Classes="h1" Text="Your setup" />
                <TextBlock Classes="muted" Text="{Binding HomeSummary}" />
              </StackPanel>

              <!-- What's new: after an update, until dismissed -->
              <Border Classes="panel" IsVisible="{Binding ShowWhatsNew}" Padding="18,14">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Classes="section" Text="{Binding WhatsNewTitle}" VerticalAlignment="Center" />
                      <TextBlock Classes="hand" Text="fresh!" VerticalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding WhatsNewLines}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Classes="body" Text="{Binding StringFormat='• {0}'}" Margin="0,1" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6" Margin="16,0,0,0" VerticalAlignment="Top">
                    <Button Classes="ghost" Content="Got it" Command="{Binding DismissWhatsNewCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    <Button Classes="link" Content="Full notes ›" Command="{Binding OpenReleaseNotesCommand}" />
                  </StackPanel>
                </Grid>
              </Border>

              <!-- At a glance: what's playing, how the PC is doing, and the fans -->
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                <Border Classes="panel" Padding="16,14">
                  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="kicker" Text="{Binding PlayingLabel}" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="link" Content="Studio ›" Command="{Binding NavigateCommand}" CommandParameter="studio" Margin="0,-6,-8,-6" />
                    </Grid>
                    <Panel Grid.Row="1" Height="64">
                      <ctl:EffectPreview Definition="{Binding ActiveCard.Effect}" Settings="{Binding ActiveCard.Settings}" Animate="{Binding !Paused}"
                                         CornerRadius="{DynamicResource RadiusPreview}" IsVisible="{Binding ActiveHasEffect}" />
                      <Border Background="{Binding ActiveSwatch}" CornerRadius="{DynamicResource RadiusSmall}" IsVisible="{Binding !ActiveHasEffect}" />
                    </Panel>
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding ActivePresetName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="8,-6,-8,-6">
                        <Button Classes="icon" Command="{Binding PreviousPresetCommand}" ToolTip.Tip="Previous preset">
                          <PathIcon Data="{x:Static ctl:NavIcons.Previous}" />
                        </Button>
                        <Button Classes="icon" Command="{Binding TogglePauseCommand}" ToolTip.Tip="{Binding PauseTip}">
                          <PathIcon Data="{Binding PauseIcon}" />
                        </Button>
                        <Button Classes="icon" Command="{Binding NextPresetCommand}" ToolTip.Tip="Next preset">
                          <PathIcon Data="{x:Static ctl:NavIcons.Next}" />
                        </Button>
                        <Button Classes="icon" Command="{Binding ShuffleCommand}" ToolTip.Tip="Random preset">
                          <PathIcon Data="{x:Static ctl:NavIcons.Shuffle}" />
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Grid>
                </Border>

                <Border Grid.Column="1" Classes="panel" Padding="16,14">
                  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="kicker" Text="System" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="link" Content="Monitoring ›" Command="{Binding NavigateCommand}" CommandParameter="monitoring" Margin="0,-6,-8,-6" />
                    </Grid>
                    <StackPanel Grid.Row="1" Spacing="7" VerticalAlignment="Center">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="muted" FontSize="13" Text="CPU" />
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Monitoring.CpuSummary}" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="muted" FontSize="13" Text="GPU" />
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Monitoring.GpuSummary}" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="muted" FontSize="13" Text="Memory" />
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Monitoring.MemorySummary}" />
                      </Grid>
                    </StackPanel>
                    <ctl:Sparkline Grid.Row="2" Values="{Binding Monitoring.Cpu.History}" Color="{Binding Monitoring.Cpu.Color}" Maximum="100" Height="26"
                                   ToolTip.Tip="CPU load, last few minutes" />
                  </Grid>
                </Border>

                <Border Grid.Column="2" Classes="panel" Padding="16,14">
                  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="kicker" Text="Cooling" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="link" Content="Cooling ›" Command="{Binding NavigateCommand}" CommandParameter="cooling" Margin="0,-6,-8,-6" />
                    </Grid>
                    <StackPanel Grid.Row="1" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Cooling.Hottest}" FontSize="30" FontWeight="Bold" Foreground="{Binding Cooling.HottestBrush}" />
                      <TextBlock Classes="muted" FontSize="13" Text="{Binding Cooling.HottestLabel}" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Classes="body" Text="{Binding Cooling.FanSummary}" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </Border>
              </Grid>

              <!-- Things that need attention -->
              <ItemsControl ItemsSource="{Binding Alerts}" IsVisible="{Binding HasAlerts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AlertViewModel">
                    <Border Classes="alert">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <PathIcon Data="{Binding Icon}" Foreground="{Binding Accent}" Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Classes="body" Text="{Binding Text}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Classes="ghost" Content="{Binding ActionLabel}" Command="{Binding Action}"
                                IsVisible="{Binding HasAction}" Margin="12,0,0,0" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Devices -->
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="section" Text="Devices" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="link" Content="Manage devices ›" Command="{Binding NavigateCommand}" CommandParameter="devices" />
                </Grid>
                <Border Classes="panel" IsVisible="{Binding !HasDevices}">
                  <TextBlock Classes="body" Text="Looking for your devices. This takes a few seconds the first time, while OpenRGB scans your hardware." />
                </Border>
                <ItemsControl ItemsSource="{Binding Devices}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeviceRowViewModel">
                      <Border Classes="tile">
                        <Grid RowDefinitions="*,Auto,Auto" RowSpacing="12">
                          <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Top">
                            <Border Classes="iconbox" VerticalAlignment="Top">
                              <PathIcon Data="{Binding Icon}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="1" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                              <TextBlock Classes="muted" Text="{Binding Type}" />
                            </StackPanel>
                            <Button Grid.Column="2" Classes="icon" Command="{Binding FlashCommand}" IsVisible="{Binding CanFlash}" VerticalAlignment="Top"
                                    Margin="6,-4,-6,0" ToolTip.Tip="Flash: pulse this device white so you can spot it">
                              <PathIcon Data="{x:Static ctl:NavIcons.Flash}" />
                            </Button>
                          </Grid>
                          <ctl:DeviceColorsBar Grid.Row="1" Host="{Binding $parent[Window].((vm:MainViewModel)DataContext).Host}" DeviceId="{Binding Id}" Height="10" />
                          <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
                            <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Classes="muted" Text="{Binding StatusText}" Margin="7,0,0,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasBattery}" ToolTip.Tip="{Binding BatteryTip}">
                              <ctl:BatteryGauge Percent="{Binding BatteryPercent}" Charging="{Binding BatteryCharging}" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding BatteryText}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                          </Grid>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Wireless devices MyRGB can read the battery of but doesn't light -->
                <ItemsControl ItemsSource="{Binding OtherBatteries}" IsVisible="{Binding HasOtherBatteries}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BatteryOnlyViewModel">
                      <Border Classes="badge" Margin="0,0,10,10" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Name}" />
                          <ctl:BatteryGauge Percent="{Binding Percent}" Charging="{Binding Charging}" IsVisible="{Binding HasStatus}" />
                          <TextBlock Text="{Binding Text}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- Quick presets -->
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="section" Text="Quick presets" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="link" Content="All presets ›" Command="{Binding NavigateCommand}" CommandParameter="presets" />
                </Grid>
                <ItemsControl ItemsSource="{Binding QuickPresets}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PresetCardViewModel">
                      <Button Classes="chip" Classes.active="{Binding IsActive}" BorderBrush="{Binding Outline}" Command="{Binding ActivateCommand}">
                        <Grid RowDefinitions="*,Auto" Margin="6">
                          <ctl:EffectPreview Definition="{Binding Effect}" Settings="{Binding Settings}" CornerRadius="{DynamicResource RadiusPreview}" IsVisible="{Binding HasEffect}"
                                             Animate="{Binding $parent[Button].IsPointerOver}" />
                          <Border Background="{Binding Swatch}" CornerRadius="{DynamicResource RadiusSmall}" IsVisible="{Binding !HasEffect}" />
                          <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Margin="3,6,3,0" TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- How it works -->
              <Border Classes="panel" Padding="22,20" IsVisible="{Binding ShowHomeGuide}">
                <StackPanel Spacing="16">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel Spacing="3">
                      <TextBlock Classes="section" Text="How MyRGB works" />
                      <TextBlock Classes="muted" Text="Four ideas, and you know the whole app." />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="link" Content="Hide" Command="{Binding HideHomeGuideCommand}" VerticalAlignment="Center" Margin="0,0,8,0"
                            ToolTip.Tip="The tour stays under How it works at the top, and in Settings." />
                    <Button Grid.Column="2" Classes="ghost" Content="Take the tour" Command="{Binding OpenTourCommand}" VerticalAlignment="Center" />
                  </Grid>
                  <UniformGrid Columns="4">
                    <StackPanel Spacing="6" Margin="0,0,18,0">
                      <TextBlock Classes="kicker" Text="1 · Devices" />
                      <TextBlock FontWeight="SemiBold" Text="It finds your hardware" />
                      <TextBlock Classes="muted" TextWrapping="Wrap" Text="Every brand, through MyRGB's own drivers and the bundled OpenRGB." />
                    </StackPanel>
                    <StackPanel Spacing="6" Margin="0,0,18,0">
                      <TextBlock Classes="kicker" Text="2 · Layout" />
                      <TextBlock FontWeight="SemiBold" Text="Your desk is one canvas" />
                      <TextBlock Classes="muted" TextWrapping="Wrap" Text="Place devices where they sit, and effects flow across all of them." />
                    </StackPanel>
                    <StackPanel Spacing="6" Margin="0,0,18,0">
                      <TextBlock Classes="kicker" Text="3 · Presets" />
                      <TextBlock FontWeight="SemiBold" Text="Pick a look, or make one" />
                      <TextBlock Classes="muted" TextWrapping="Wrap" Text="Apply a preset in one click, or tune any effect live in the Studio." />
                    </StackPanel>
                    <StackPanel Spacing="6">
                      <TextBlock Classes="kicker" Text="4 · Anywhere" />
                      <TextBlock FontWeight="SemiBold" Text="It runs in the tray" />
                      <TextBlock Classes="muted" TextWrapping="Wrap" Text="Close the window and the lights stay on. Use the tray or a Stream Deck." />
                    </StackPanel>
                  </UniformGrid>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ===== Presets ===== -->
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="{x:Static ctl:NavIcons.Presets}" />
              <TextBlock Text="Presets" VerticalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,8">
              <StackPanel Spacing="4">
                <TextBlock Classes="h1" Text="Presets" />
                <TextBlock Classes="muted" Text="Click a preset to light everything with it. Right-click to edit, delete or export. Editing a built-in makes your own copy." />
              </StackPanel>
              <TextBox Grid.Column="1" Text="{Binding ImportPresetPath}" PlaceholderText="Path to a .myrgb-preset.json file" Width="260" VerticalAlignment="Center" Margin="16,0,10,0" />
              <Button Grid.Column="2" Classes="ghost" Content="Import" Command="{Binding ImportPresetCommand}" VerticalAlignment="Center" Margin="0,0,10,0" />
              <Button Grid.Column="3" Classes="accent" Content="+ New preset" Command="{Binding NewPresetCommand}" VerticalAlignment="Center" />
            </Grid>
            <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,16" Text="{Binding PresetIoStatus}"
                       IsVisible="{Binding PresetIoStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Presets}" Margin="0,4,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PresetCardViewModel">
                    <Border Classes="cardglow" BoxShadow="{Binding Glow}">
                      <Button Classes="card" Classes.active="{Binding IsActive}" BorderBrush="{Binding Outline}" Command="{Binding ActivateCommand}">
                        <Button.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Apply" Command="{Binding ActivateCommand}" />
                            <MenuItem Header="Edit in Studio" Command="{Binding EditCommand}" />
                            <MenuItem Header="Export to file" Command="{Binding ExportCommand}" />
                            <MenuItem Header="Delete" Command="{Binding DeleteCommand}" IsVisible="{Binding !IsBuiltIn}" />
                          </ContextMenu>
                        </Button.ContextMenu>
                        <Grid RowDefinitions="*,Auto" Margin="8">
                          <!-- A still of the preset; it plays while hovered or while it's the one on. -->
                          <ctl:EffectPreview Definition="{Binding Effect}" Settings="{Binding Settings}" CornerRadius="{DynamicResource RadiusPreview}"
                                             IsVisible="{Binding HasEffect}">
                            <ctl:EffectPreview.Animate>
                              <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                <Binding Path="IsActive" />
                                <Binding Path="IsPointerOver" RelativeSource="{RelativeSource AncestorType=Button}" />
                              </MultiBinding>
                            </ctl:EffectPreview.Animate>
                          </ctl:EffectPreview>
                          <Border Background="{Binding Swatch}" CornerRadius="{DynamicResource RadiusSmall}" IsVisible="{Binding !HasEffect}" />
                          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="4,9,4,1">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Classes="badge">
                              <TextBlock Text="{Binding Badge}" />
                            </Border>
                          </Grid>
                        </Grid>
                      </Button>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </TabItem>

        <!-- ===== Community ===== -->
        <TabItem IsVisible="{Binding CloudAvailable}">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="{x:Static ctl:NavIcons.Community}" />
              <TextBlock Text="Community" VerticalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,16">
              <StackPanel Spacing="4">
                <TextBlock Classes="h1" Text="Community" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="Presets other MyRGB users made. Install one to add it to your presets; anyone can browse, and sharing needs an account." />
              </StackPanel>
              <TextBox Grid.Column="1" Text="{Binding Community.Search}" PlaceholderText="Search presets" Width="220" VerticalAlignment="Center" Margin="16,0,10,0" />
              <ComboBox Grid.Column="2" ItemsSource="{Binding Community.SortOptions}" SelectedItem="{Binding Community.Sort}" VerticalAlignment="Center" MinWidth="150" />
            </Grid>

            <!-- Share one of your own presets -->
            <Border DockPanel.Dock="Top" Classes="panel" Margin="0,0,0,16" Padding="16,12">
              <Grid>
                <StackPanel Spacing="8" IsVisible="{Binding Community.IsSignedIn}">
                  <TextBlock Classes="section" Text="Share a preset" />
                  <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding Community.HasShareable}">
                    <ComboBox ItemsSource="{Binding Community.Shareable}" SelectedItem="{Binding Community.ToShare}" MinWidth="220">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="presets:Preset">
                          <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Text="{Binding Community.ShareDescription}" PlaceholderText="Say something about it (optional)" Width="360" MaxLength="280" />
                    <Button Classes="accent" Content="Share" Command="{Binding Community.ShareCommand}" />
                  </StackPanel>
                  <TextBlock Classes="muted" Text="Make a preset in the Studio first; then you can share it here." IsVisible="{Binding !Community.HasShareable}" />
                  <TextBlock Classes="muted" Text="{Binding Community.ShareStatus}" />
                </StackPanel>
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !Community.IsSignedIn}">
                  <TextBlock Classes="body" Text="Sign in to share your own presets with everyone." VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="ghost" Content="Sign in" Command="{Binding NavigateCommand}" CommandParameter="account" />
                </Grid>
              </Grid>
            </Border>

            <TextBlock DockPanel.Dock="Top" Classes="muted" Text="{Binding Community.Status}" Margin="2,0,0,8" />
            <TextBlock DockPanel.Dock="Top" Classes="body" Text="Nobody has shared a preset that matches yet." IsVisible="{Binding Community.IsEmpty}" />

            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Community.Items}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SharedPresetViewModel">
                    <Border Classes="tile" Height="NaN" Width="260" Padding="10">
                      <StackPanel Spacing="8">
                        <Panel Height="84">
                          <ctl:EffectPreview Definition="{Binding Effect}" Settings="{Binding Settings}" CornerRadius="{DynamicResource RadiusPreview}"
                                             Animate="{Binding $parent[Border].IsPointerOver}" IsVisible="{Binding Supported}" />
                          <Border Background="{Binding Swatch}" CornerRadius="{DynamicResource RadiusSmall}" IsVisible="{Binding !Supported}" />
                        </Panel>
                        <StackPanel Spacing="1" Margin="4,0">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="muted">
                              <Run Text="{Binding Author}" />
                              <Run Text=" · " />
                              <Run Text="{Binding Downloads}" />
                            </TextBlock>
                            <Border Classes="supporter" IsVisible="{Binding AuthorSupporter}" ToolTip.Tip="Supports MyRGB"><TextBlock Text="♥" /></Border>
                          </StackPanel>
                          <TextBlock Classes="muted" Text="{Binding Description}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                     IsVisible="{Binding HasDescription}" Margin="0,4,0,0" />
                          <TextBlock Classes="muted" Text="{Binding Unsupported}" Foreground="{DynamicResource WarningBrush}" IsVisible="{Binding !Supported}" />
                        </StackPanel>
                        <!-- Votes: one up or down each, plus a suggestion for MyRGB's built-in presets. -->
                        <Grid ColumnDefinitions="Auto,*" Margin="2,0" ToolTip.Tip="{Binding VoteTip}">
                          <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button Classes="ghost" Classes.accent="{Binding VotedUp}" Content="▲" Padding="9,3" FontSize="11"
                                    Command="{Binding UpVoteCommand}" IsEnabled="{Binding CanVote}" ToolTip.Tip="Vote up" />
                            <TextBlock Text="{Binding ScoreText}" FontFamily="{DynamicResource NumberFont}" FontWeight="SemiBold"
                                       MinWidth="26" TextAlignment="Center" VerticalAlignment="Center" />
                            <Button Classes="ghost" Classes.accent="{Binding VotedDown}" Content="▼" Padding="9,3" FontSize="11"
                                    Command="{Binding DownVoteCommand}" IsEnabled="{Binding CanVote}" ToolTip.Tip="Vote down" />
                          </StackPanel>
                          <Button Grid.Column="1" Classes="link" Content="{Binding NominateText}" Command="{Binding ToggleNominateCommand}"
                                  IsEnabled="{Binding CanVote}" HorizontalAlignment="Right" FontSize="12"
                                  ToolTip.Tip="Suggest this as one of the presets MyRGB comes with. The most suggested are considered for the next release." />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,0">
                          <Button Classes="accent" Content="Install" Command="{Binding InstallCommand}" />
                          <Button Classes="link" Content="Remove" Command="{Binding RemoveCommand}" IsVisible="{Binding IsMine}" />
                          <Button Classes="link" Content="Report" Command="{Binding AskReportCommand}" IsVisible="{Binding CanReport}" />
                        </StackPanel>
                        <StackPanel Spacing="6" IsVisible="{Binding Reporting}" Margin="2,0">
                          <TextBox Text="{Binding ReportReason}" PlaceholderText="What's wrong with it?" MaxLength="500" />
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Classes="ghost" Content="Send report" Command="{Binding SendReportCommand}" />
                            <Button Classes="link" Content="Cancel" Command="{Binding CancelReportCommand}" />
                          </StackPanel>
                        </StackPanel>
                        <TextBlock Classes="muted" Text="{Binding Status}" TextWrapping="Wrap" Margin="2,0" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </TabItem>

        <!-- ===== Studio (effect editor) ===== -->
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="{x:Static ctl:NavIcons.Studio}" />
              <TextBlock Text="Studio" VerticalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,6">
              <TextBox Text="{Binding Studio.PresetName}" PlaceholderText="Preset name" FontSize="16" />
              <Button Grid.Column="1" Content="Save" Command="{Binding Studio.SaveCommand}" Classes="accent" Margin="10,0,0,0" />
              <Button Grid.Column="2" Classes="ghost" Content="Save as new" Command="{Binding Studio.SaveAsNewCommand}" Margin="8,0,0,0" />
              <Button Grid.Column="3" Classes="ghost" Content="Discard" Command="{Binding Studio.RevertCommand}" Margin="8,0,0,0"
                      ToolTip.Tip="Stop previewing and go back to the preset you had on" />
            </Grid>
            <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="2,0,0,16"
                       Text="Everything you change plays on your devices right away. Save keeps it as a preset." />

            <Grid ColumnDefinitions="*,18,320">
              <!-- Left: the live preview, and the effects to pick from under it. -->
              <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                  <TextBlock Classes="kicker" Text="Live preview" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="ghost" Content="Tidy up" Command="{Binding TidyLayoutCommand}" IsVisible="{Binding ArrangingLayout}"
                            ToolTip.Tip="Nudge overlapping devices apart and leave the rest where they are" />
                    <Button Classes="ghost" Content="Reset" Command="{Binding ResetLayoutCommand}" IsVisible="{Binding ArrangingLayout}"
                            ToolTip.Tip="Put every device back in its default spot" />
                    <ctl:Switch IsChecked="{Binding ArrangingLayout}" OnContent="Arrange devices" OffContent="Arrange devices"
                                ToolTip.Tip="Drag each device to where it sits on your desk, and drag a corner to resize it" />
                  </StackPanel>
                </Grid>
                <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,8" IsVisible="{Binding ArrangingLayout}"
                           Text="This is your desk seen from the front. Drag each device to where it really sits and drag a corner to resize it, so waves flow from one device to the next." />
                <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,16,0,0">
                  <TextBlock Classes="kicker" Text="Effect" />
                  <ListBox Classes="chips" ItemsSource="{Binding Studio.Effects}" SelectedItem="{Binding Studio.SelectedEffect}"
                           IsEnabled="{Binding Studio.ShowEffectEditor}" MaxHeight="226" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel ItemWidth="134" />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:EffectItem">
                        <StackPanel ToolTip.Tip="{Binding Description}" Spacing="1">
                          <ctl:EffectPreview Definition="{Binding Definition}" Height="40" Margin="0,0,0,7" />
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="4,0" />
                          <TextBlock Classes="muted" FontSize="11" Text="{Binding Category}" Margin="4,0" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <!-- Effects people write themselves, from Documents\MyRGB Effects. -->
                  <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2,0,0">
                    <TextBlock Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                               Text="{Binding Studio.EffectFolderStatus}" />
                    <Button Grid.Column="1" Classes="ghost" Content="Your effects folder" Command="{Binding Studio.OpenEffectsFolderCommand}"
                            ToolTip.Tip="Every .js file in this folder shows up in the list above. Opening it the first time adds a few examples and a short guide." />
                    <Button Grid.Column="2" Classes="ghost" Content="Reload" Margin="6,0,0,0" Command="{Binding Studio.ReloadEffectsCommand}"
                            ToolTip.Tip="Read the folder again after you add, change or delete an effect file" />
                  </Grid>
                </StackPanel>
                <ctl:LedCanvas Host="{Binding Host}" HighlightId="{Binding Studio.SelectedTarget.DeviceId}" MinHeight="180"
                               AllowEditing="{Binding ArrangingLayout}" />
              </DockPanel>

              <!-- Right: what's being edited, and its settings. -->
              <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Classes="panel" Padding="16,14" Margin="0,0,0,14">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="kicker" Text="Edit for" />
                    <ComboBox ItemsSource="{Binding Studio.Targets}" SelectedItem="{Binding Studio.SelectedTarget}" HorizontalAlignment="Stretch" />
                    <ComboBox ItemsSource="{Binding Studio.Modes}" SelectedItem="{Binding Studio.TargetMode}" HorizontalAlignment="Stretch"
                              IsVisible="{Binding Studio.IsDeviceTarget}" />
                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Studio.TargetHint}" />
                  </StackPanel>
                </Border>

                <Border Classes="panel" Padding="16,14">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,12">
                      <TextBlock Classes="section" Text="{Binding Studio.SettingsTitle}" />
                      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Studio.SettingsDescription}"
                                 IsVisible="{Binding Studio.SettingsDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="body" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="{Binding Studio.EffectProblem}"
                               IsVisible="{Binding Studio.EffectProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock DockPanel.Dock="Top" Classes="body" Foreground="{DynamicResource MutedBrush}" Text="{Binding Studio.SettingsHint}"
                               IsVisible="{Binding !Studio.HasParameters}" />
                    <ScrollViewer>
                      <ItemsControl ItemsSource="{Binding Studio.Parameters}">
                        <ItemsControl.DataTemplates>
                          <DataTemplate DataType="vm:ColorParameterViewModel">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,10">
                              <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                              <ColorPicker Grid.Column="1" Color="{Binding Color}" IsAlphaVisible="False" />
                            </Grid>
                          </DataTemplate>
                          <DataTemplate DataType="vm:NumberParameterViewModel">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,4,0,6">
                              <TextBlock Text="{Binding Label}" />
                              <TextBlock Grid.Column="1" Text="{Binding Display}" FontFamily="{DynamicResource BrandMono}" FontSize="12"
                                         Foreground="{DynamicResource InkSecondaryBrush}" />
                              <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="{Binding Min}" Maximum="{Binding Max}" SmallChange="{Binding Step}"
                                      TickFrequency="{Binding Step}" IsSnapToTickEnabled="True" Value="{Binding Value}" />
                            </Grid>
                          </DataTemplate>
                          <DataTemplate DataType="vm:ChoiceParameterViewModel">
                            <StackPanel Spacing="6" Margin="0,4,0,12">
                              <TextBlock Text="{Binding Label}" />
                              <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                          </DataTemplate>
                          <DataTemplate DataType="vm:BoolParameterViewModel">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,8">
                              <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                              <ctl:Switch Grid.Column="1" IsChecked="{Binding Value}" OnContent="" OffContent="" MinWidth="0" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.DataTemplates>
                      </ItemsControl>
                    </ScrollViewer>
                  </DockPanel>
                </Border>
              </DockPanel>
            </Grid>
          </DockPanel>
        </TabItem>

        <!-- ===== Wallpapers ===== -->
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="{x:Static ctl:NavIcons.Wallpapers}" />
              <TextBlock Text="Wallpapers" VerticalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
              <StackPanel Spacing="4">
                <TextBlock Classes="h1" Text="Wallpapers" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="MyRGB can play a moving wallpaper behind your desktop icons, and your lights can take their colors from it. It pauses by itself while a game or full-screen video covers the screen." />
              </StackPanel>
              <ctl:Switch Grid.Column="1" IsChecked="{Binding Wallpapers.On}" OnContent="Wallpaper on" OffContent="Wallpaper off" VerticalAlignment="Top" Margin="16,4,0,0" />
            </Grid>
            <Border DockPanel.Dock="Top" Classes="panel" Padding="16,12" Margin="0,0,0,16">
              <TextBlock Classes="body" TextWrapping="Wrap" Text="{Binding Wallpapers.Status}" />
            </Border>

            <ScrollViewer>
              <StackPanel Spacing="16">
                <Border Classes="panel" Padding="18,16">
                  <StackPanel Spacing="12">
                    <TextBlock Classes="section" Text="What the wallpaper shows" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="ghost" Classes.accent="{Binding Wallpapers.FromLights}" Content="Your lights" Command="{Binding Wallpapers.SetSourceCommand}" CommandParameter="Lights"
                              ToolTip.Tip="The wallpaper plays whatever preset your lights play, and changes with them" />
                      <Button Classes="ghost" Classes.accent="{Binding Wallpapers.FromPreset}" Content="A preset" Command="{Binding Wallpapers.SetSourceCommand}" CommandParameter="Preset"
                              ToolTip.Tip="The wallpaper plays one preset, whatever your lights do" />
                      <Button Classes="ghost" Classes.accent="{Binding Wallpapers.FromPicture}" Content="A picture" Command="{Binding Wallpapers.SetSourceCommand}" CommandParameter="Picture"
                              ToolTip.Tip="A still picture from a file" />
                      <Button Classes="ghost" Classes.accent="{Binding Wallpapers.FromVideo}" Content="A video" Command="{Binding Wallpapers.SetSourceCommand}" CommandParameter="Video"
                              ToolTip.Tip="A video file, looping, without sound" />
                    </StackPanel>

                    <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding Wallpapers.FromLights}"
                               Text="Switch presets from Presets, the tray, a hotkey or a Stream Deck, and the wallpaper follows along." />

                    <StackPanel Spacing="10" IsVisible="{Binding Wallpapers.FromPicture}">
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Classes="accent" Content="Choose a picture" Command="{Binding Wallpapers.ChoosePictureCommand}" />
                        <TextBlock Classes="muted" Text="{Binding Wallpapers.PictureName}" VerticalAlignment="Center" />
                      </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="10" IsVisible="{Binding Wallpapers.FromVideo}">
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Classes="accent" Content="Choose a video" Command="{Binding Wallpapers.ChooseVideoCommand}" />
                        <TextBlock Classes="muted" Text="{Binding Wallpapers.VideoName}" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Classes="muted" TextWrapping="Wrap"
                                 Text="Plays on a loop, without sound, filling each screen. MP4 (H.264) always works; HEVC, VP9 and AV1 videos need Microsoft's free video extensions from the Store." />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Wallpapers.Scenes}" IsVisible="{Binding Wallpapers.FromPreset}">
                      <ItemsControl.Styles>
                        <Style Selector="Button.card.active">
                          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                          <Setter Property="BorderThickness" Value="2" />
                        </Style>
                      </ItemsControl.Styles>
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WallpaperSceneViewModel">
                          <Button Classes="card" Classes.active="{Binding IsSelected}" Command="{Binding ChooseCommand}" Width="200" Height="146">
                            <Grid RowDefinitions="*,Auto" Margin="8">
                              <ctl:EffectPreview Definition="{Binding Effect}" Settings="{Binding Settings}" CornerRadius="{DynamicResource RadiusPreview}">
                                <ctl:EffectPreview.Animate>
                                  <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                    <Binding Path="IsSelected" />
                                    <Binding Path="IsPointerOver" RelativeSource="{RelativeSource AncestorType=Button}" />
                                  </MultiBinding>
                                </ctl:EffectPreview.Animate>
                              </ctl:EffectPreview>
                              <TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="4,9,4,1" />
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <Border Classes="panel" Padding="18,16">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="section" Text="Lights that match" />
                      <TextBlock Classes="muted" TextWrapping="Wrap"
                                 Text="The Match Wallpaper preset lights each device from the part of the screen it sits by on your layout (Studio, Arrange devices). With MyRGB's wallpaper off, it matches Windows' own wallpaper picture." />
                      <TextBlock Classes="body" Text="{Binding Wallpapers.LightsLabel}" Margin="0,6,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="accent" Content="Match my lights" Command="{Binding Wallpapers.MatchLightsCommand}"
                            IsVisible="{Binding !Wallpapers.LightsMatch}" VerticalAlignment="Top" Margin="16,0,0,0" />
                  </Grid>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </TabItem>

        <!-- ===== Devices ===== -->
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="{x:Static ctl:NavIcons.Devices}" />
              <TextBlock Text="Devices" VerticalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
              <StackPanel Spacing="4">
                <TextBlock Classes="h1" Text="Devices" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="Everything MyRGB found. Switch a device off to leave it alone, for example so another app can light it." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Ellipse Width="7" Height="7" Fill="{DynamicResource RgbGradient}" VerticalAlignment="Center" />
                  <TextBlock Classes="muted" Text="{Binding ProviderStatus}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Classes="ghost" Classes.accent="{Binding !DevicesGrid}" Content="List" Command="{Binding SetDevicesGridCommand}" CommandParameter="False" />
                <Button Classes="ghost" Classes.accent="{Binding DevicesGrid}" Content="Grid" Command="{Binding SetDevicesGridCommand}" CommandParameter="True" />
                <Button Classes="ghost" Content="Scan again" Command="{Binding RescanCommand}" IsEnabled="{Binding !IsScanning}" Margin="10,0,0,0" />
              </StackPanel>
            </Grid>
            <ScrollViewer>
              <StackPanel Spacing="10" Margin="0,0,8,8">
                <!-- Grid: a lit drawing of each device. Setting up zones and screens happens in the list. -->
                <ItemsControl ItemsSource="{Binding Devices}" IsVisible="{Binding DevicesGrid}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeviceRowViewModel">
                      <Border Classes="panel" Width="236" Margin="0,0,12,12" Padding="14,12">
                        <StackPanel Spacing="10">
                          <ctl:DeviceThumb Host="{Binding $parent[Window].((vm:MainViewModel)DataContext).Host}" DeviceId="{Binding Id}" Kind="{Binding Kind}"
                                           Height="96" Opacity="{Binding ThumbOpacity}" />
                          <StackPanel Spacing="1">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                            <TextBlock Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis">
                              <Run Text="{Binding Vendor}" /><Run Text=" · " /><Run Text="{Binding Type}" />
                            </TextBlock>
                          </StackPanel>
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                              <Border Classes="badge"><TextBlock Text="{Binding LedBadge}" /></Border>
                              <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding HasBattery}" ToolTip.Tip="{Binding BatteryTip}">
                                <ctl:BatteryGauge Percent="{Binding BatteryPercent}" Charging="{Binding BatteryCharging}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding BatteryText}" FontSize="12" VerticalAlignment="Center" />
                              </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="icon" Command="{Binding FlashCommand}" IsVisible="{Binding CanFlash}"
                                    ToolTip.Tip="Flash: pulse this device white so you can spot it">
                              <PathIcon Data="{x:Static ctl:NavIcons.Flash}" />
                            </Button>
                          </Grid>
                          <ctl:Switch IsChecked="{Binding Included}" OnContent="MyRGB controls it" OffContent="Left alone" />
                          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding NeedsSetup}"
                                     Text="Needs its LED count set: switch to List to set it up." />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Devices}" IsVisible="{Binding !DevicesGrid}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeviceRowViewModel">
                      <Border Classes="panel" Margin="0,0,0,8" Padding="16,12">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <Border Classes="iconbox" VerticalAlignment="Top">
                            <PathIcon Data="{Binding Icon}" />
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="6" Margin="14,0,16,0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                              <Border Classes="badge"><TextBlock Text="{Binding LedBadge}" /></Border>
                              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasBattery}" ToolTip.Tip="{Binding BatteryTip}">
                                <ctl:BatteryGauge Percent="{Binding BatteryPercent}" Charging="{Binding BatteryCharging}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding BatteryText}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Classes="hand" Text="{Binding BatteryNote}" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                              </StackPanel>
                            </StackPanel>
                            <TextBlock Classes="muted">
                              <Run Text="{Binding Vendor}" />
                              <Run Text=" · " />
                              <Run Text="{Binding Type}" />
                              <Run Text=" · " />
                              <Run Text="{Binding Connection}" />
                            </TextBlock>
                            <TextBlock Classes="muted" Text="{Binding Zones}" TextWrapping="Wrap" IsVisible="{Binding ShowZones}" />
                            <ctl:DeviceColorsBar Host="{Binding $parent[Window].((vm:MainViewModel)DataContext).Host}" DeviceId="{Binding Id}"
                                                 Height="6" HorizontalAlignment="Left" Width="320" Margin="0,2,0,0" IsVisible="{Binding !NeedsSetup}" />
                            <ItemsControl ItemsSource="{Binding ResizableZones}" IsVisible="{Binding HasResizableZones}" Margin="0,4,0,0">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ZoneSizeViewModel">
                                  <Grid ColumnDefinitions="180,Auto,Auto,Auto" Margin="0,3">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding LedCount}" Minimum="{Binding Min}" Maximum="{Binding Max}"
                                                   Increment="1" FormatString="0" Width="130" />
                                    <TextBlock Grid.Column="2" Classes="muted" Text="{Binding Range}" VerticalAlignment="Center" Margin="10,0" />
                                    <Button Grid.Column="3" Classes="accent" Content="Apply" Command="{Binding ApplyCommand}" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Panel Margin="0,8,0,0" IsVisible="{Binding HasScreen}"><Grid ColumnDefinitions="Auto,*" DataContext="{Binding Screen}"
                                  x:DataType="vm:ScreenViewModel">
                              <Border Width="124" Height="85" CornerRadius="{DynamicResource RadiusSmall}" ClipToBounds="True" Background="{DynamicResource ScreenWellBrush}" VerticalAlignment="Top"
                                      BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                                <Panel>
                                  <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                                  <TextBlock Classes="muted" Text="{Binding PlaceholderText}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                             IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNull}}" />
                                </Panel>
                              </Border>
                              <StackPanel Grid.Column="1" Spacing="6" Margin="14,0,0,0">
                                <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                  <Button Classes="accent" Content="Choose picture…" Command="{Binding ChooseImageCommand}"
                                          ToolTip.Tip="Store a picture on the keyboard. It's cropped to fill the screen." />
                                  <Button Classes="ghost" Content="Remove" Command="{Binding RemoveImageCommand}" IsVisible="{Binding HasImage}"
                                          ToolTip.Tip="Take MyRGB's picture off and put the screen back as it was" />
                                </StackPanel>
                                <ctl:Switch IsChecked="{Binding ScreenFirst}" OnContent="Show the screen" OffContent="Show the screen"
                                              ToolTip.Tip="{Binding ScreenFirstHint}" />
                                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" MaxWidth="460" HorizontalAlignment="Left"
                                           Text="{Binding ScreenFirstHint}" />
                                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding Status}"
                                           IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                              </StackPanel>
                            </Grid></Panel>
                          </StackPanel>
                          <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Right">
                            <ctl:Switch IsChecked="{Binding Included}" OnContent="MyRGB controls it" OffContent="Left alone" />
                            <Button Classes="ghost" Command="{Binding FlashCommand}" IsVisible="{Binding CanFlash}" HorizontalAlignment="Right"
                                    ToolTip.Tip="Pulse this device white for a few seconds, so you can see which one it is">
                              <StackPanel Orientation="Horizontal" Spacing="7">
                                <PathIcon Data="{x:Static ctl:NavIcons.Flash}" Width="14" Height="14" />
                                <TextBlock Text="Flash" />
                              </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" IsVisible="{Binding NeedsSetup}">
                              <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                              <TextBlock Classes="muted" Text="{Binding StatusText}" />
                            </StackPanel>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Classes="panel">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="section" Text="Something missing?" />
                    <TextBlock Classes="body" Text="• A brand app may be holding it. Corsair devices often vanish while iCUE runs. Quit the app (check the system tray too) and click Scan again. Settings lists the ones installed." />
                    <TextBlock Classes="body" Text="• Fan and LED-strip controllers can't tell how many LEDs are plugged in. Set each channel's count on the device above (LEDs per fan × number of fans, e.g. 16 for one LL120)." />
                    <TextBlock Classes="body" Text="• RGB RAM needs the optional SMBus driver. Run MyRGB setup again and tick “Enable RAM / SMBus lighting”." />
                    <Button Classes="link" Content="Vendor apps in Settings ›" Command="{Binding NavigateCommand}" CommandParameter="vendors" HorizontalAlignment="Left" IsVisible="{Binding Vendors.HasApps}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </TabItem>

        <!-- ===== Monitoring ===== -->
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="{x:Static ctl:NavIcons.Monitoring}" />
              <TextBlock Text="Monitoring" VerticalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
              <StackPanel Spacing="4">
                <TextBlock Classes="h1" Text="Monitoring" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding MonitoringIntro}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="16,0,0,0">
                <Button Classes="ghost" Classes.accent="{Binding !ShowCooling}" Content="Readings" Command="{Binding SetShowCoolingCommand}" CommandParameter="False" />
                <Button Classes="ghost" Classes.accent="{Binding ShowCooling}" Content="Cooling" Command="{Binding SetShowCoolingCommand}" CommandParameter="True" />
              </StackPanel>
            </Grid>
            <Panel>
          <Panel IsVisible="{Binding !ShowCooling}">
          <DockPanel DataContext="{Binding Monitoring}" x:DataType="vm:MonitoringViewModel">
            <ScrollViewer>
              <StackPanel Spacing="14" Margin="0,0,8,8">
                <Border Classes="panel" IsVisible="{Binding !HasReadings}">
                  <TextBlock Classes="body" Text="Reading your sensors…" />
                </Border>

                <ItemsControl ItemsSource="{Binding Cards}" IsVisible="{Binding HasReadings}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MetricCard">
                      <Border Classes="panel" Margin="0,0,14,14" Padding="18,16,18,14">
                        <StackPanel Spacing="10">
                          <Grid ColumnDefinitions="Auto,*">
                            <Ellipse Width="8" Height="8" Fill="{Binding Accent}" VerticalAlignment="Center" Margin="0,0,9,0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                              <TextBlock Classes="section" Text="{Binding Title}" />
                              <TextBlock Classes="muted" Text="{Binding Subtitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </Grid>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Value}" FontSize="34" FontWeight="Bold" LetterSpacing="-1" />
                            <TextBlock Classes="muted" Text="{Binding Unit}" FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,7" />
                          </StackPanel>
                          <ctl:Sparkline Values="{Binding History}" Color="{Binding Color}" Maximum="{Binding Max}" Height="64" />
                          <ItemsControl ItemsSource="{Binding Lines}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:MetricLine">
                                <StackPanel Margin="0,0,22,0" Spacing="1">
                                  <TextBlock Classes="kicker" Text="{Binding Label}" />
                                  <TextBlock Text="{Binding Value}" FontFamily="{DynamicResource BrandMono}" FontSize="13" />
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid ColumnDefinitions="*,14,*" IsVisible="{Binding HasReadings}" Margin="0,-14,14,0">
                  <Border Classes="panel">
                    <StackPanel Spacing="12">
                      <TextBlock Classes="section" Text="CPU threads" />
                      <ItemsControl ItemsSource="{Binding Threads}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ThreadLoad">
                            <ProgressBar Classes="meter" Orientation="Vertical" Minimum="0" Maximum="100" Value="{Binding Percent}"
                                         Height="70" MinWidth="0" Margin="2,0" ToolTip.Tip="{Binding Percent, StringFormat='{}{0:0} %'}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="2" Classes="panel">
                    <StackPanel Spacing="12">
                      <TextBlock Classes="section" Text="Drives" />
                      <ItemsControl ItemsSource="{Binding Drives}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:DriveViewModel">
                            <StackPanel Spacing="5" Margin="0,0,0,10">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Detail}" />
                              </Grid>
                              <ProgressBar Classes="meter" Minimum="0" Maximum="100" Value="{Binding Percent}" Height="6" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </Grid>

                <Border Classes="panel" Margin="0,0,14,0" IsVisible="{Binding HasReadings}">
                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Classes="section" Text="Every sensor" />
                        <TextBlock Classes="muted" Text="The full list, straight from the hardware." />
                      </StackPanel>
                      <ctl:Switch Grid.Column="1" IsChecked="{Binding ShowAll}" OnContent="Shown" OffContent="Hidden" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding AllSensors}" IsVisible="{Binding ShowAll}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SensorRow">
                          <Grid ColumnDefinitions="260,*,Auto" Margin="0,2">
                            <TextBlock Classes="muted" Text="{Binding Hardware}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding Value}" FontFamily="{DynamicResource BrandMono}" FontSize="12" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
          </Panel>

          <!-- Cooling: temperatures and the fans MyRGB drives -->
          <Panel IsVisible="{Binding ShowCooling}">
          <DockPanel DataContext="{Binding Cooling}" x:DataType="vm:CoolingViewModel">
            <ScrollViewer>
              <StackPanel Spacing="14" Margin="0,0,8,8">
                <ItemsControl ItemsSource="{Binding Temps}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TempGauge">
                      <Border Classes="panel" Margin="0,0,14,0" Padding="16,14">
                        <StackPanel Spacing="6">
                          <TextBlock Classes="kicker" Text="{Binding Label}" />
                          <TextBlock Text="{Binding Value}" FontSize="30" FontWeight="Bold" Foreground="{Binding Brush}" IsVisible="{Binding Available}" />
                          <TextBlock Text="needs admin" FontSize="15" Foreground="{DynamicResource SubtleBrush}" IsVisible="{Binding !Available}" Margin="0,8,0,9" />
                          <ProgressBar Classes="meter" Minimum="0" Maximum="100" Value="{Binding Percent}" Height="5" Foreground="{Binding Brush}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Classes="panel" Margin="0,0,14,0" IsVisible="{Binding NeedsAdmin}">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="section" Text="Fan control needs administrator" />
                    <TextBlock Classes="body" IsVisible="{Binding !HelperConnected}"
                               Text="Your CPU's temperature and the fans on your motherboard are only readable for programs running as administrator. One Windows permission prompt sets up a small helper that reads them for MyRGB, which carries on running normally without any." />
                    <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding !HelperConnected}">
                      <Button Classes="accent" Content="Enable CPU temperatures and fans" Command="{Binding EnableHelperCommand}"
                              ToolTip.Tip="Windows asks for permission once. MyRGB keeps running; temperatures appear within a few seconds." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HelperConnected}">
                      <PathIcon Data="{x:Static ctl:NavIcons.Check}" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                      <TextBlock Classes="body" VerticalAlignment="Center" TextWrapping="Wrap"
                                 Text="The helper is running: CPU temperatures and fan control are on. It starts with Windows, and uninstalling MyRGB removes it." />
                      <Button Classes="link" Content="Turn off" Command="{Binding TurnOffHelperCommand}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Spacing="10" IsVisible="{Binding HelperOutdated}">
                      <TextBlock Classes="body" TextWrapping="Wrap"
                                 Text="This MyRGB needs a newer helper. One permission prompt updates it; your fan settings stay as they are. Ordinary MyRGB updates don't need this." />
                      <Button Classes="ghost" Content="Update the helper" Command="{Binding EnableHelperCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                    <TextBlock Classes="muted" Text="{Binding AdminStatus}" TextWrapping="Wrap"
                               IsVisible="{Binding AdminStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,14,10" IsVisible="{Binding HasFans}">
                  <TextBlock Classes="muted" Text="{Binding FanSummary}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="ghost" Content="New curve…" Command="{Binding Builder.OpenCommand}"
                          ToolTip.Tip="Build a curve and it joins every fan's mode dropdown" Margin="0,0,10,0" />
                  <Button Grid.Column="2" Classes="ghost" Content="All automatic" Command="{Binding AllAutomaticCommand}"
                          ToolTip.Tip="Every fan back to its hardware default" Margin="0,0,10,0" />
                  <ctl:Switch Grid.Column="3" IsChecked="{Binding GridView}" OnContent="Grid" OffContent="List" VerticalAlignment="Center" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Fans}" IsVisible="{Binding !GridView}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FanRowViewModel">
                      <Border Classes="panel" Margin="0,0,14,14">
                        <StackPanel Spacing="12">
                          <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="iconbox"><PathIcon Data="{x:Static ctl:NavIcons.Cooling}" /></Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="1">
                              <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                                <Border Classes="badge"><TextBlock Text="{Binding Speed}" /></Border>
                              </StackPanel>
                              <TextBlock Classes="muted" Text="{Binding Status}" />
                            </StackPanel>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding Choices}" SelectedItem="{Binding Mode}" MinWidth="170" VerticalAlignment="Center" />
                          </Grid>
                          <TextBlock Classes="muted" Text="{Binding ModeHint}" />

                          <!-- One click from automatic to a working curve. -->
                          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsAuto}">
                            <TextBlock Classes="muted" Text="Make it a curve:" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <Button Classes="ghost" Content="Silent" Command="{Binding QuickCurveCommand}" CommandParameter="silent" />
                            <Button Classes="ghost" Content="Quiet" Command="{Binding QuickCurveCommand}" CommandParameter="quiet" />
                            <Button Classes="ghost" Content="Balanced" Command="{Binding QuickCurveCommand}" CommandParameter="balanced" />
                            <Button Classes="ghost" Content="Performance" Command="{Binding QuickCurveCommand}" CommandParameter="performance" />
                            <Button Classes="ghost" Content="Full speed" Command="{Binding QuickCurveCommand}" CommandParameter="full" />
                          </StackPanel>

                          <Grid ColumnDefinitions="*,60" IsVisible="{Binding IsFixed}">
                            <Slider Minimum="0" Maximum="100" Value="{Binding FixedPercent}" TickFrequency="1" IsSnapToTickEnabled="True" />
                            <TextBlock Grid.Column="1" Text="{Binding FixedPercent, StringFormat='{}{0:0} %'}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource BrandMono}" />
                          </Grid>

                          <StackPanel Spacing="10" IsVisible="{Binding IsCurve}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                              <TextBlock Text="Follows" VerticalAlignment="Center" />
                              <ComboBox ItemsSource="{Binding Follow}" SelectedItem="{Binding Sensor}" MinWidth="220" />
                            </StackPanel>
                            <!-- A curve can watch several temperatures and follow the hottest. -->
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Classes="muted" Text="Also watch:" VerticalAlignment="Center" Margin="0,0,4,0"
                                         ToolTip.Tip="The fan follows whichever of these is hottest at the moment." />
                              <ItemsControl ItemsSource="{Binding AlsoWatch}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:WatchOption">
                                    <Button Classes="ghost" Classes.accent="{Binding IsOn}" Content="{Binding Label}" Command="{Binding ToggleCommand}" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                            <ctl:FanCurveChart Points="{Binding Points}" CurrentTemp="{Binding CurrentTemp}" Height="230" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Classes="muted" Text="Presets:" VerticalAlignment="Center" Margin="0,0,4,0" />
                              <Button Classes="ghost" Content="Silent" Command="{Binding SilentCommand}" />
                              <Button Classes="ghost" Content="Quiet" Command="{Binding QuietCommand}" />
                              <Button Classes="ghost" Content="Balanced" Command="{Binding BalancedCommand}" />
                              <Button Classes="ghost" Content="Performance" Command="{Binding PerformanceCommand}" />
                              <Button Classes="ghost" Content="Full speed" Command="{Binding FullSpeedCommand}" />
                            </StackPanel>
                          </StackPanel>

                          <!-- Copy another fan's speed, so a group of fans runs in step. -->
                          <StackPanel Spacing="10" IsVisible="{Binding IsMatch}">
                            <TextBlock Classes="muted" Text="There's no other fan to copy yet." IsVisible="{Binding !HasOtherFans}" />
                            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasOtherFans}">
                              <TextBlock Text="Copies" VerticalAlignment="Center" />
                              <ComboBox ItemsSource="{Binding OtherFans}" SelectedItem="{Binding MatchFan}" MinWidth="220" />
                            </StackPanel>
                            <Grid ColumnDefinitions="Auto,*,60" IsVisible="{Binding HasOtherFans}">
                              <TextBlock Text="Faster or slower by" VerticalAlignment="Center" Margin="0,0,10,0" />
                              <Slider Grid.Column="1" Minimum="-30" Maximum="30" Value="{Binding MatchOffset}" TickFrequency="1" IsSnapToTickEnabled="True" />
                              <TextBlock Grid.Column="2" Text="{Binding MatchOffset, StringFormat='{}{0:+0;-0;0} %'}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                         FontFamily="{DynamicResource BrandMono}" />
                            </Grid>
                          </StackPanel>

                          <!-- Lowest speed: a fan asked for less than it can turn at just sits still and hums. -->
                          <Grid ColumnDefinitions="Auto,*,60" IsVisible="{Binding !IsAuto}">
                            <TextBlock Text="Lowest speed" VerticalAlignment="Center" Margin="0,0,10,0"
                                       ToolTip.Tip="MyRGB never runs it slower than this, except at 0 %. Testing the fan finds the right number." />
                            <Slider Grid.Column="1" Minimum="0" Maximum="60" Value="{Binding MinSpinPercent}" TickFrequency="1" IsSnapToTickEnabled="True" />
                            <TextBlock Grid.Column="2" Text="{Binding MinSpinPercent, StringFormat='{}{0:0} %'}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource BrandMono}" />
                          </Grid>

                          <!-- Fan test: finds the top speed, and where it stops and starts again. -->
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                              <TextBlock Classes="muted" Text="{Binding CalibrationText}" IsVisible="{Binding HasCalibration}" TextWrapping="Wrap" />
                              <TextBlock Classes="muted" Text="Not tested yet. A test takes about two minutes; the fan speeds up and slows down, and may stop for a moment."
                                         IsVisible="{Binding !HasCalibration}" TextWrapping="Wrap" />
                              <TextBlock Classes="body" Text="{Binding TestStatus}" IsVisible="{Binding TestStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="ghost" Content="Test this fan" Command="{Binding StartTestCommand}" IsVisible="{Binding !Testing}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            <Button Grid.Column="1" Classes="ghost" Content="Stop test" Command="{Binding StopTestCommand}" IsVisible="{Binding Testing}" VerticalAlignment="Center" Margin="12,0,0,0" />
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Grid view: compact tiles for switching several fans at a glance.
                     The chart stays in the list view; tiles carry name, speed and mode. -->
                <ItemsControl ItemsSource="{Binding Fans}" IsVisible="{Binding GridView}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FanRowViewModel">
                      <Border Classes="panel" Width="264" Margin="0,0,12,12" Padding="14,12">
                        <StackPanel Spacing="8">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" ToolTip.Tip="{Binding Name}" />
                            <Border Grid.Column="1" Classes="badge"><TextBlock Text="{Binding Speed}" /></Border>
                          </Grid>
                          <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Mode}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                          <TextBlock Classes="muted" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Classes="panel" Margin="0,0,14,0" IsVisible="{Binding !HasFans}">
                  <TextBlock Classes="body" Text="MyRGB hasn't found a fan it can control yet." />
                </Border>

              </StackPanel>
            </ScrollViewer>
          </DockPanel>
          </Panel>
            </Panel>
          </DockPanel>
        </TabItem>

        <!-- ===== Settings ===== -->
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="{x:Static ctl:NavIcons.Settings}" />
              <TextBlock Text="{l:Tr nav.settings}" VerticalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
          <ScrollViewer>
            <StackPanel Spacing="14" MaxWidth="760" HorizontalAlignment="Left">
              <TextBlock Classes="h1" Text="{l:Tr nav.settings}" Margin="0,0,0,6" />

              <!-- Vendor apps: only while one is installed; Home links here when one is running. -->
              <Border Classes="panel" IsVisible="{Binding Vendors.HasApps}">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="section" Text="{l:Tr settings.vendorApps.title}" />
                      <TextBlock Classes="muted" TextWrapping="Wrap"
                                 Text="{l:Tr settings.vendorApps.brandAppsLikeIcue}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="ghost" Content="{l:Tr settings.vendorApps.checkAgain}" Command="{Binding Vendors.CheckCommand}" IsEnabled="{Binding !Vendors.IsChecking}" VerticalAlignment="Top" Margin="16,0,0,0" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Vendors.Apps}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:VendorAppViewModel">
                        <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="{DynamicResource RadiusSmall}" Margin="0,0,0,10" Padding="16,14">
                          <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Classes="muted">
                                  <Run Text="{Binding Version}" />
                                  <Run Text="  ·  " />
                                  <Run Text="{Binding RunningText}" />
                                </TextBlock>
                              </StackPanel>
                              <Border Grid.Column="1" Classes="badge" Padding="10,4" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                  <Ellipse Width="8" Height="8" Fill="{Binding VerdictBrush}" VerticalAlignment="Center" />
                                  <TextBlock Text="{Binding VerdictTitle}" FontSize="12" />
                                </StackPanel>
                              </Border>
                            </Grid>
        
                            <TextBlock Classes="body" Text="{Binding Verdict}" />
        
                            <StackPanel Spacing="6" IsVisible="{Binding HasControlledDevices}">
                              <TextBlock Classes="kicker" Text="{l:Tr settings.vendorApps.myrgbNowRuns}" />
                              <ItemsControl ItemsSource="{Binding ControlledDevices}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="x:String">
                                    <Border Classes="badge" Margin="0,0,6,6"><TextBlock Text="{Binding}" /></Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
        
                            <StackPanel Spacing="6" IsVisible="{Binding HasLosses}">
                              <TextBlock Classes="kicker" Text="{l:Tr settings.vendorApps.notReplaced}" />
                              <ItemsControl ItemsSource="{Binding YouWouldLose}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="x:String">
                                    <TextBlock Classes="body" Text="{Binding StringFormat='• {0}'}" Margin="0,1" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
        
                            <Border Background="{DynamicResource InfoWashBrush}" CornerRadius="{DynamicResource RadiusSmall}" Padding="12,9" IsVisible="{Binding HasTip}">
                              <Grid ColumnDefinitions="Auto,*">
                                <PathIcon Data="{x:Static ctl:NavIcons.Info}" Foreground="{DynamicResource InfoBrush}" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,10,0" />
                                <TextBlock Grid.Column="1" Classes="body" Text="{Binding Tip}" />
                              </Grid>
                            </Border>
        
                            <StackPanel Spacing="6" IsVisible="{Binding HasComponents}">
                              <TextBlock Classes="kicker" Text="{l:Tr settings.vendorApps.installedAlongWithIt}" />
                              <ItemsControl ItemsSource="{Binding Components}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:ComponentViewModel">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                      <TextBlock Classes="body" Text="{Binding Name}" VerticalAlignment="Center" />
                                      <Button Grid.Column="1" Classes="link" Content="{l:Tr settings.vendorApps.uninstall}" Command="{Binding UninstallCommand}" IsVisible="{Binding CanUninstall}" />
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
        
                            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding !Confirming}">
                              <Button Classes="accent" Content="{Binding Name, Converter={x:Static l:Tr.Format}, ConverterParameter=settings.vendorApps.uninstallApp}" Command="{Binding AskUninstallCommand}" IsVisible="{Binding CanUninstall}" />
                            </StackPanel>
                            <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}" Padding="14,12" IsVisible="{Binding Confirming}">
                              <StackPanel Spacing="10">
                                <TextBlock Classes="body" TextWrapping="Wrap"
                                           Text="{Binding Name, Converter={x:Static l:Tr.Format}, ConverterParameter=settings.vendorApps.uninstallConfirm}" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                  <Button Classes="accent" Content="{l:Tr settings.vendorApps.openUninstaller}" Command="{Binding UninstallCommand}" />
                                  <Button Classes="ghost" Content="{l:Tr common.cancel}" Command="{Binding CancelUninstallCommand}" />
                                </StackPanel>
                              </StackPanel>
                            </Border>
                            <TextBlock Classes="muted" Text="{Binding Status}" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <!-- Appearance: the whole look, switched live. -->
              <Border Classes="panel">
                <StackPanel Spacing="12">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="section" Text="{l:Tr settings.appearance.title}" />
                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:Tr settings.appearance.pickALookFor}" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding Themes}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ThemeOptionViewModel">
                        <Button Classes="themecard" Classes.picked="{Binding IsSelected}" Command="{Binding PickCommand}" ToolTip.Tip="{Binding Description}">
                          <StackPanel>
                            <!-- A thumbnail of the theme: its page, a card on it, a line of ink and its accent. -->
                            <Border Height="74" Background="{Binding Page}" Padding="12,10">
                              <Border Background="{Binding Surface}" Padding="9,8" BorderBrush="{Binding Edge}" BorderThickness="1">
                                <StackPanel Spacing="6">
                                  <Border Height="5" Width="70" HorizontalAlignment="Left" Background="{Binding Ink}" />
                                  <Border Height="4" Width="96" HorizontalAlignment="Left" Background="{Binding Edge}" />
                                  <Border Height="8" Width="40" HorizontalAlignment="Left" Background="{Binding Accent}" />
                                </StackPanel>
                              </Border>
                            </Border>
                            <StackPanel Margin="10,8,10,10" Spacing="1">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                              <TextBlock Classes="muted" Text="{Binding Description}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <!-- Language: only once there's a translation to pick. Used from the next start. -->
              <Border Classes="panel" IsVisible="{Binding Language.ShowPicker}">
                <StackPanel Spacing="10">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="section" Text="{l:Tr settings.language.title}" />
                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:Tr settings.language.about}" />
                  </StackPanel>
                  <ComboBox ItemsSource="{Binding Language.Options}" SelectedItem="{Binding Language.Selected}" MinWidth="220" />
                  <TextBlock Classes="body" TextWrapping="Wrap" Text="{Binding Language.RestartNote}"
                             IsVisible="{Binding Language.RestartNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
              </Border>

              <!-- Account (only in builds with the account service) -->
              <Border Classes="panel" IsVisible="{Binding CloudAvailable}">
                <StackPanel Spacing="12">
                  <TextBlock Classes="section" Text="{l:Tr settings.account.title}" />

                  <StackPanel Spacing="10" IsVisible="{Binding Account.IsSignedOut}">
                    <TextBlock Classes="body" Text="{l:Tr settings.account.anAccountIsOptional}" />
                    <ItemsControl ItemsSource="{Binding Account.Providers}" IsEnabled="{Binding !Account.IsBusy}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProviderButton">
                          <Button Classes="ghost" Content="{Binding Label}" Command="{Binding Command}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding Account.IsBusy}">
                      <TextBlock Classes="muted" Text="{Binding Account.Status}" VerticalAlignment="Center" />
                      <Button Classes="link" Content="{l:Tr common.cancel}" Command="{Binding Account.CancelSignInCommand}" />
                    </StackPanel>
                  </StackPanel>

                  <StackPanel Spacing="12" IsVisible="{Binding Account.IsSignedIn}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <Border Classes="avatar" Width="40" Height="40">
                        <TextBlock Text="{Binding Account.Initial}" FontSize="17" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Account.DisplayName}" FontWeight="SemiBold" />
                        <TextBlock Classes="muted">
                          <Run Text="{Binding Account.Email}" />
                          <Run Text="  ·  " />
                          <Run Text="{Binding Account.ProviderText}" />
                        </TextBlock>
                      </StackPanel>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                      <ctl:Switch IsChecked="{Binding Account.SyncPresets}" OnContent="{l:Tr settings.account.syncMyPresetsAcross}" OffContent="{l:Tr settings.account.syncMyPresetsAcross}" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Classes="muted" Text="{Binding Account.SyncStatus}" VerticalAlignment="Center" />
                        <Button Classes="ghost" Content="{l:Tr settings.account.syncNow}" Command="{Binding Account.SyncNowCommand}" IsEnabled="{Binding Account.SyncPresets}" />
                      </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding !Account.ConfirmingDelete}">
                      <Button Classes="ghost" Content="{l:Tr settings.account.signOut}" Command="{Binding Account.SignOutCommand}" />
                      <Button Classes="link" Content="{l:Tr settings.account.askDelete}" Command="{Binding Account.AskDeleteCommand}" Foreground="{DynamicResource DangerBrush}" />
                    </StackPanel>
                    <Border Background="{DynamicResource DangerWashBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}" Padding="14,12" IsVisible="{Binding Account.ConfirmingDelete}">
                      <StackPanel Spacing="10">
                        <TextBlock Classes="body" Text="{l:Tr settings.account.thisPermanentlyDeletesYour}" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <Button Classes="ghost" Content="{l:Tr settings.account.confirmDelete}" Command="{Binding Account.DeleteAccountCommand}" Foreground="{DynamicResource DangerBrush}" />
                          <Button Classes="link" Content="{l:Tr common.cancel}" Command="{Binding Account.CancelDeleteCommand}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  <TextBlock Classes="muted" Text="{Binding Account.Status}" TextWrapping="Wrap" IsVisible="{Binding !Account.IsBusy}" />
                </StackPanel>
              </Border>

              <!-- Supporting MyRGB: every feature is free; support funds the work and the servers. -->
              <Border Classes="panel">
                <Border.IsVisible>
                  <MultiBinding Converter="{x:Static BoolConverters.Or}">
                    <Binding Path="Account.HasSupportLinks" />
                    <Binding Path="Account.IsSupporter" />
                  </MultiBinding>
                </Border.IsVisible>
                <StackPanel Spacing="10">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="section" Text="{l:Tr settings.supportMyrgb.title}" />
                    <Border Classes="supporter" IsVisible="{Binding Account.IsSupporter}"><TextBlock Text="{l:Tr settings.supportMyrgb.badge}" /></Border>
                  </StackPanel>
                  <TextBlock Classes="body" Text="{l:Tr settings.supportMyrgb.myrgbIsFreeAnd}" />
                  <TextBlock Classes="body" Text="{l:Tr settings.supportMyrgb.supportersGetABadge}" />
                  <TextBlock Classes="body" Foreground="{DynamicResource AccentBrush}" Text="{Binding Account.SupporterText}" IsVisible="{Binding Account.IsSupporter}" />
                  <ctl:Switch IsChecked="{Binding Account.ShowBadge}" IsVisible="{Binding Account.IsSupporter}"
                                OnContent="{l:Tr settings.supportMyrgb.showMySupporterBadge}" OffContent="{l:Tr settings.supportMyrgb.showMySupporterBadge}" />
                  <ItemsControl ItemsSource="{Binding Account.SupportLinks}" IsVisible="{Binding Account.HasSupportLinks}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:LinkButton">
                        <Button Classes="accent" Content="{Binding Label}" Command="{Binding Command}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding Account.HasSupportLinks}"
                             Text="{l:Tr settings.supportMyrgb.supportWithTheSame}" />
                </StackPanel>
              </Border>

              <Border Classes="panel">
                <StackPanel Spacing="10">
                  <TextBlock Classes="section" Text="{l:Tr settings.startup.title}" />
                  <ctl:Switch IsChecked="{Binding StartWithWindows}" OnContent="{l:Tr settings.startup.startWithWindows}" OffContent="{l:Tr settings.startup.startWithWindows}" />
                  <ctl:Switch IsChecked="{Binding StartMinimized}" OnContent="{l:Tr settings.startup.startHiddenInThe}" OffContent="{l:Tr settings.startup.startHiddenInThe}" />
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:Tr settings.startup.closingTheWindowNever}" />
                </StackPanel>
              </Border>

              <!-- Updates: quiet checks against the project's GitHub releases -->
              <Border Classes="panel">
                <StackPanel Spacing="10">
                  <TextBlock Classes="section" Text="{l:Tr settings.updates.title}" />
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <ctl:Switch IsChecked="{Binding CheckForUpdates}" OnContent="{l:Tr settings.updates.checkForUpdatesWhen}" OffContent="{l:Tr settings.updates.checkForUpdatesWhen}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Update.VersionText}" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Classes="ghost" Content="{l:Tr settings.updates.checkNow}" Command="{Binding Update.CheckCommand}" IsEnabled="{Binding !Update.Busy}" />
                  </Grid>
                  <TextBlock Classes="muted" Text="{Binding Update.Status}" TextWrapping="Wrap"
                             IsVisible="{Binding Update.Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:Tr settings.updates.updatesDownloadFromThe}" />
                </StackPanel>
              </Border>

              <Border Classes="panel">
                <StackPanel Spacing="10">
                  <TextBlock Classes="section" Text="{l:Tr settings.idleDimming.title}" />
                  <ctl:Switch IsChecked="{Binding IdleDimOn}" OnContent="{l:Tr settings.idleDimming.dimWhenYouStep}" OffContent="{l:Tr settings.idleDimming.dimWhenYouStep}" />
                  <Grid ColumnDefinitions="200,*,60" IsEnabled="{Binding IdleDimOn}">
                    <TextBlock Text="{l:Tr settings.idleDimming.afterMinutes}" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Minimum="1" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding IdleDimAfterMinutes}" />
                    <TextBlock Grid.Column="2" Text="{Binding IdleDimAfterMinutes}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                  </Grid>
                  <Grid ColumnDefinitions="200,*,60" IsEnabled="{Binding IdleDimOn}">
                    <TextBlock Text="{l:Tr settings.idleDimming.dimTo}" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding IdleDimPercent}" />
                    <TextBlock Grid.Column="2" Text="{Binding IdleDimPercent}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                  </Grid>
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:Tr settings.idleDimming.lightsFadeDownAfter}" />
                </StackPanel>
              </Border>

              <Border Classes="panel">
                <StackPanel Spacing="10">
                  <TextBlock Classes="section" Text="{l:Tr settings.lightsOut.title}" />
                  <ctl:Switch IsChecked="{Binding OffWhenLocked}" OnContent="{l:Tr settings.lightsOut.offWhileWindowsIs}" OffContent="{l:Tr settings.lightsOut.offWhileWindowsIs}" />
                  <ctl:Switch IsChecked="{Binding NightOn}" OnContent="{l:Tr settings.lightsOut.offAtNight}" OffContent="{l:Tr settings.lightsOut.offAtNight}" />
                  <StackPanel Orientation="Horizontal" Spacing="10" IsEnabled="{Binding NightTimesEnabled}">
                    <TextBlock Text="{l:Tr settings.lightsOut.from}" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding NightChoices}" SelectedItem="{Binding NightFrom}" MinWidth="100" />
                    <TextBlock Text="{l:Tr settings.lightsOut.to}" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding NightChoices}" SelectedItem="{Binding NightTo}" MinWidth="100" />
                  </StackPanel>
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:Tr settings.lightsOut.yourLightsGoDark}" />
                </StackPanel>
              </Border>

              <Border Classes="panel">
                <StackPanel Spacing="10">
                  <TextBlock Classes="section" Text="{l:Tr settings.monitors.title}" />
                  <ctl:Switch IsChecked="{Binding MonitorsOn}" IsEnabled="{Binding MonitorsSupported}" OnContent="{l:Tr settings.monitors.setMyMonitorsBrightness}" OffContent="{l:Tr settings.monitors.setMyMonitorsBrightness}" />
                  <TextBlock Classes="muted" Text="{Binding MonitorStatus}" TextWrapping="Wrap" />
                  <StackPanel Spacing="10" IsEnabled="{Binding ShowMonitorSlider}">
                    <Grid ColumnDefinitions="200,*,60">
                      <TextBlock Text="{l:Tr settings.monitors.brightness}" VerticalAlignment="Center" />
                      <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding MonitorLevel}" />
                      <TextBlock Grid.Column="2" Text="{Binding MonitorLevel}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <ctl:Switch IsChecked="{Binding MonitorsFollowLights}" OnContent="{l:Tr settings.monitors.dimWithTheLights}" OffContent="{l:Tr settings.monitors.dimWithTheLights}" VerticalAlignment="Center" />
                      <ComboBox ItemsSource="{Binding MonitorSteps}" SelectedItem="{Binding MonitorsOffLevel}" IsEnabled="{Binding MonitorsFollowLights}" MinWidth="80" />
                      <TextBlock Text="%" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <ctl:Switch IsChecked="{Binding MonitorsNightOn}" OnContent="{l:Tr settings.monitors.atNightSetThem}" OffContent="{l:Tr settings.monitors.atNightSetThem}" VerticalAlignment="Center" />
                      <ComboBox ItemsSource="{Binding MonitorSteps}" SelectedItem="{Binding MonitorsNightLevel}" IsEnabled="{Binding MonitorsNightOn}" MinWidth="80" />
                      <TextBlock Text="%" VerticalAlignment="Center" />
                    </StackPanel>
                    <ctl:Switch IsChecked="{Binding MonitorPresetLevelsOn}" OnContent="{l:Tr settings.monitors.presetsSetTheirOwn}" OffContent="{l:Tr settings.monitors.presetsSetTheirOwn}" />
                    <ItemsControl ItemsSource="{Binding MonitorPresetRows}" IsEnabled="{Binding MonitorPresetLevelsOn}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MonitorPresetRow">
                          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10" Margin="0,0,0,6">
                            <ComboBox ItemsSource="{Binding AvailablePresets}"
                                      SelectedValueBinding="{Binding Id}" SelectedValue="{Binding PresetId}"
                                      DisplayMemberBinding="{Binding Name}" HorizontalAlignment="Stretch" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Steps}" SelectedItem="{Binding Level}" MinWidth="80" />
                            <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" />
                            <Button Grid.Column="3" Classes="ghost" Content="✕" Command="{Binding RemoveCommand}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Classes="ghost" Content="{l:Tr settings.monitors.addAPreset}" Command="{Binding AddMonitorPresetLevelCommand}" IsEnabled="{Binding MonitorPresetLevelsOn}" />
                    <StackPanel Spacing="6" IsVisible="{Binding ShowMonitorRanges}" Margin="0,6,0,0">
                      <TextBlock FontWeight="SemiBold" Text="{l:Tr settings.monitors.matchYourMonitors}" />
                      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:Tr settings.monitors.twoMonitorsAtThe}" />
                      <ItemsControl ItemsSource="{Binding MonitorRangeRows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:MonitorRangeRow">
                            <Grid ColumnDefinitions="200,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" Margin="0,0,0,6">
                              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="1" Classes="muted" Text="{l:Tr settings.monitors.from}" VerticalAlignment="Center" />
                              <ComboBox Grid.Column="2" ItemsSource="{Binding DarkestChoices}" SelectedItem="{Binding Darkest}" MinWidth="80" />
                              <TextBlock Grid.Column="3" Classes="muted" Text="{l:Tr settings.monitors.to}" VerticalAlignment="Center" />
                              <ComboBox Grid.Column="4" ItemsSource="{Binding BrightestChoices}" SelectedItem="{Binding Brightest}" MinWidth="80" />
                              <TextBlock Grid.Column="5" Text="%" VerticalAlignment="Center" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:Tr settings.monitors.nightUsesTheTimes}" />
                </StackPanel>
              </Border>

              <Border Classes="panel">
                <StackPanel Spacing="10">
                  <TextBlock Classes="section" Text="{l:Tr settings.appProfiles.title}" />
                  <ctl:Switch IsChecked="{Binding AppProfilesOn}" OnContent="{l:Tr settings.appProfiles.switchPresetsByApp}" OffContent="{l:Tr settings.appProfiles.switchPresetsByApp}" />
                  <ItemsControl ItemsSource="{Binding AppProfileRows}" IsEnabled="{Binding AppProfilesOn}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AppProfileRow">
                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="10" Margin="0,0,0,6">
                          <TextBox Text="{Binding ProcessName}" PlaceholderText="{l:Tr settings.appProfiles.processNameEG}" />
                          <ComboBox Grid.Column="1" ItemsSource="{Binding AvailablePresets}"
                                    SelectedValueBinding="{Binding Id}" SelectedValue="{Binding PresetId}"
                                    DisplayMemberBinding="{Binding Name}" HorizontalAlignment="Stretch" />
                          <Button Grid.Column="2" Classes="ghost" Content="✕" Command="{Binding RemoveCommand}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsEnabled="{Binding AppProfilesOn}">
                    <TextBox Text="{Binding NewAppProfileProcess}" PlaceholderText="{l:Tr settings.appProfiles.processNameEG}" />
                    <Button Grid.Column="1" Classes="ghost" Content="{l:Tr common.add}" Command="{Binding AddAppProfileCommand}" />
                  </Grid>
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:Tr settings.appProfiles.whenOneOfThese}" />
                </StackPanel>
              </Border>

              <Border Classes="panel">
                <StackPanel Spacing="10">
                  <TextBlock Classes="section" Text="{l:Tr settings.schedule.title}" />
                  <ctl:Switch IsChecked="{Binding ScheduleOn}" OnContent="{l:Tr settings.schedule.changePresetsThroughThe}" OffContent="{l:Tr settings.schedule.changePresetsThroughThe}" />
                  <ItemsControl ItemsSource="{Binding ScheduleRows}" IsEnabled="{Binding ScheduleOn}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ScheduleRow">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10" Margin="0,0,0,6">
                          <TextBlock Text="{l:Tr settings.schedule.at}" VerticalAlignment="Center" />
                          <ComboBox Grid.Column="1" ItemsSource="{Binding Times}" SelectedItem="{Binding At}" MinWidth="100" />
                          <ComboBox Grid.Column="2" ItemsSource="{Binding AvailablePresets}"
                                    SelectedValueBinding="{Binding Id}" SelectedValue="{Binding PresetId}"
                                    DisplayMemberBinding="{Binding Name}" HorizontalAlignment="Stretch" />
                          <Button Grid.Column="3" Classes="ghost" Content="✕" Command="{Binding RemoveCommand}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Classes="ghost" Content="{l:Tr settings.schedule.addATime}" Command="{Binding AddScheduleEntryCommand}" IsEnabled="{Binding ScheduleOn}" />
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:Tr settings.schedule.atEachTimeMyrgb}" />
                </StackPanel>
              </Border>

              <Border Classes="panel">
                <StackPanel Spacing="10">
                  <TextBlock Classes="section" Text="{l:Tr settings.globalHotkeys.title}" />
                  <ctl:Switch IsChecked="{Binding GlobalHotkeyOn}" OnContent="{l:Tr settings.globalHotkeys.useKeyboardShortcutsFrom}" OffContent="{l:Tr settings.globalHotkeys.useKeyboardShortcutsFrom}" />
                  <ItemsControl ItemsSource="{Binding Hotkeys}" IsEnabled="{Binding GlobalHotkeyOn}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="svc:HotkeyStatus">
                        <Grid ColumnDefinitions="160,*,Auto" Margin="0,0,0,4">
                          <TextBlock FontFamily="{DynamicResource BrandMono}" FontSize="12" Text="{Binding Keys}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding Does}" VerticalAlignment="Center" TextWrapping="Wrap" />
                          <TextBlock Grid.Column="2" Classes="muted" Text="{l:Tr settings.globalHotkeys.takenByAnotherApp}" IsVisible="{Binding Taken}" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding HotkeysNote}" />
                </StackPanel>
              </Border>

              <Border Classes="panel">
                <StackPanel Spacing="10">
                  <TextBlock Classes="section" Text="{l:Tr settings.smoothness.title}" />
                  <Grid ColumnDefinitions="200,*,60">
                    <TextBlock Text="{l:Tr settings.smoothness.updatesPerSecond}" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Minimum="10" Maximum="60" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Fps}" />
                    <TextBlock Grid.Column="2" Text="{Binding Fps}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                  </Grid>
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:Tr settings.smoothness.30LooksSmoothFor}" />
                </StackPanel>
              </Border>

              <Border Classes="panel">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="section" Text="{l:Tr settings.videoWallpapers.title}" VerticalAlignment="Center" />
                    <ctl:Switch Grid.Column="1" IsChecked="{Binding Wallpapers.VideoUseGpu}" OnContent="{l:Tr settings.videoWallpapers.useTheGraphicsCard}" OffContent="{l:Tr settings.videoWallpapers.useTheGraphicsCard}" />
                  </Grid>
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="{l:Tr settings.videoWallpapers.yourGraphicsCardHas}" />
                  <TextBlock Classes="body" TextWrapping="Wrap" Text="{Binding Wallpapers.DecodingNote}" />
                </StackPanel>
              </Border>

              <Border Classes="panel">
                <StackPanel Spacing="8">
                  <TextBlock Classes="section" Text="{l:Tr settings.streamDeck.title}" />
                  <TextBlock Classes="body" Text="{Binding StreamDeckStatus}" />
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:Tr settings.streamDeck.keysCanSwitchPresets}" />
                </StackPanel>
              </Border>

              <Border Classes="panel">
                <StackPanel Spacing="10">
                  <TextBlock Classes="section" Text="{l:Tr settings.help.title}" />
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Classes="ghost" Content="{l:Tr settings.help.showTheWelcomeTour}" Command="{Binding OpenTourCommand}" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                    <StackPanel Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0">
                      <TextBlock Text="{l:Tr settings.help.getInTouch}" FontWeight="SemiBold" />
                      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:Tr settings.help.questionsBugsOrA}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="accent" Content="{l:Tr settings.help.visitRootlabsUs}" Command="{Binding OpenWebsiteCommand}"
                            VerticalAlignment="Center" ToolTip.Tip="{x:Static vm:MainViewModel.WebsiteUrl}" />
                  </Grid>
                </StackPanel>
              </Border>

              <Expander Classes="panel" Header="{l:Tr settings.advanced.title}" HorizontalAlignment="Stretch">
                <StackPanel Spacing="14" Margin="0,6,0,0">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{l:Tr settings.advanced.openrgbProgram}" FontWeight="SemiBold" />
                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:Tr settings.advanced.myrgbStartsOpenrgbOut}" />
                    <TextBox Text="{Binding OpenRgbPath}" PlaceholderText="{l:Tr settings.advanced.pathToOpenrgbExe}" />
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <TextBlock Text="{l:Tr settings.advanced.localApiForScripts}" FontWeight="SemiBold" />
                    <SelectableTextBlock Text="{Binding ApiUrl}" FontFamily="{DynamicResource BrandMono}" />
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <TextBlock Text="{l:Tr settings.advanced.logFile}" FontWeight="SemiBold" />
                    <SelectableTextBlock Text="{Binding LogPath}" FontFamily="{DynamicResource BrandMono}" />
                  </StackPanel>
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </DockPanel>

    <!-- ===== Support note: bottom right, after a week of use ===== -->
    <Border IsVisible="{Binding SupportNudge.IsOpen}" Width="330" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Classes="dialog">
      <StackPanel>
        <Border Classes="dialogstripe" />
        <StackPanel Margin="18,14,18,14" Spacing="6">
          <TextBlock Classes="section" Text="Like MyRGB?" />
          <TextBlock Classes="body" Text="Buy the devs a cup of joe; it keeps them going." />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
            <Button Classes="accent" Content="Buy a coffee" Command="{Binding SupportNudge.SupportCommand}" />
            <Button Classes="ghost" Content="Maybe later" Command="{Binding SupportNudge.LaterCommand}" />
          </StackPanel>
          <Button Classes="link" Content="Don't ask again" Command="{Binding SupportNudge.NeverCommand}" HorizontalAlignment="Left" Margin="-6,0,0,0" FontSize="12" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ===== Curve builder: describe a curve, save it, and it joins every fan's mode dropdown ===== -->
    <Border IsVisible="{Binding Cooling.Builder.IsOpen}" Background="{DynamicResource OverlayBrush}">
      <Border Width="580" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="dialog"
              DataContext="{Binding Cooling.Builder}" x:DataType="vm:CurveBuilderViewModel">
        <StackPanel>
          <Border Classes="dialogstripe" />
          <StackPanel Margin="32,24,32,24" Spacing="14">
            <StackPanel Spacing="2">
              <TextBlock Classes="kicker" Text="New custom curve" />
              <TextBlock Text="Build a shape, give it a name, and it joins every fan's mode dropdown." FontSize="14"
                         TextWrapping="Wrap" Foreground="{DynamicResource InkSecondaryBrush}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="Follows" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding Follows}" SelectedItem="{Binding Follow}" MinWidth="250" />
            </StackPanel>
            <Grid ColumnDefinitions="150,*,56">
              <TextBlock Text="Starts ramping at" VerticalAlignment="Center" />
              <Slider Grid.Column="1" Minimum="25" Maximum="70" Value="{Binding Start}" TickFrequency="1" IsSnapToTickEnabled="True" />
              <TextBlock Grid.Column="2" Text="{Binding Start, StringFormat='{}{0:0}°'}" HorizontalAlignment="Right" VerticalAlignment="Center"
                         FontFamily="{DynamicResource BrandMono}" />
            </Grid>
            <Grid ColumnDefinitions="150,*,56">
              <TextBlock Text="Full speed at" VerticalAlignment="Center" />
              <Slider Grid.Column="1" Minimum="45" Maximum="95" Value="{Binding Full}" TickFrequency="1" IsSnapToTickEnabled="True" />
              <TextBlock Grid.Column="2" Text="{Binding Full, StringFormat='{}{0:0}°'}" HorizontalAlignment="Right" VerticalAlignment="Center"
                         FontFamily="{DynamicResource BrandMono}" />
            </Grid>
            <Grid ColumnDefinitions="150,*,56">
              <TextBlock Text="Minimum speed" VerticalAlignment="Center" />
              <Slider Grid.Column="1" Minimum="0" Maximum="60" Value="{Binding Min}" TickFrequency="1" IsSnapToTickEnabled="True" />
              <TextBlock Grid.Column="2" Text="{Binding Min, StringFormat='{}{0:0} %'}" HorizontalAlignment="Right" VerticalAlignment="Center"
                         FontFamily="{DynamicResource BrandMono}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="Shape" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding Shapes}" SelectedItem="{Binding Shape}" MinWidth="170" />
            </StackPanel>

            <ctl:FanCurveChart Points="{Binding Preview}" CurrentTemp="{Binding CurrentTemp}" Height="170" />

            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBox PlaceholderText="Name this curve…" Text="{Binding ShapeName}" Width="200" VerticalContentAlignment="Center" />
              <Button Classes="accent" Content="Save curve" Command="{Binding SaveShapeCommand}" />
              <Button Classes="ghost" Content="Close" Command="{Binding CancelCommand}" />
            </StackPanel>
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Saved curves appear by name in every fan's mode dropdown. Pick one there and the fan follows it; editing that fan's points afterwards gives it its own copy." />

            <ItemsControl ItemsSource="{Binding Saved}" IsVisible="{Binding Saved.Count}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sensors:SavedCurve">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,4">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name, StringFormat='{}“{0}”'}" FontWeight="SemiBold" />
                      <TextBlock Classes="muted" Text="{Binding SensorKey}" FontFamily="{DynamicResource BrandMono}" FontSize="11" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="link" Content="Remove" Foreground="{DynamicResource DangerBrush}"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Cooling.Builder.DeleteSavedCommand}"
                            CommandParameter="{Binding}" Margin="10,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- ===== First-run tour (also opened from "How it works") ===== -->
    <Border IsVisible="{Binding ShowWelcome}" Background="{DynamicResource OverlayBrush}">
      <Border Width="640" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="dialog"
              DataContext="{Binding Welcome}" x:DataType="vm:WelcomeViewModel">
        <StackPanel>
          <Border Classes="dialogstripe" />
          <StackPanel Margin="40,34,40,28" Spacing="16">
            <Border Classes="avatar" Width="56" Height="56" HorizontalAlignment="Left">
              <PathIcon Data="{Binding Current.Icon}" Foreground="White" Width="26" Height="26" />
            </Border>
            <StackPanel Spacing="6">
              <TextBlock Classes="kicker" Text="{Binding Current.Kicker}" />
              <TextBlock Text="{Binding Current.Title}" FontSize="26" FontWeight="Bold" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Classes="body" FontSize="14" LineHeight="22" Text="{Binding Current.Body}" MinHeight="110" IsVisible="{Binding !Current.IsCheck}" />
            <TextBlock Classes="body" FontSize="14" LineHeight="22" Text="{Binding Current.Body}" IsVisible="{Binding Current.IsCheck}" />

            <!-- The hardware check: pick a pulse color, then say whether everything lit up. -->
            <StackPanel Spacing="14" IsVisible="{Binding Current.IsCheck}">
              <ItemsControl ItemsSource="{Binding Swatches}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FlashSwatch">
                    <Button Classes="swatch" Classes.picked="{Binding IsSelected}" Command="{Binding PickCommand}" Background="{Binding Brush}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="muted" Text="{Binding FoundText}" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Is everything pulsing?" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Button Classes="ghost" Content="Yes, all of it" Command="{Binding AnswerCommand}" CommandParameter="yes" />
                <Button Classes="ghost" Content="Something isn't" Command="{Binding AnswerCommand}" CommandParameter="no" />
              </StackPanel>
              <Border Classes="note" IsVisible="{Binding AnsweredYes}">
                <TextBlock Classes="body" Text="Great, MyRGB can reach all of it. Next, put each device where it sits on your desk." />
              </Border>
              <Border Classes="note" IsVisible="{Binding AnsweredNo}">
                <StackPanel Spacing="8">
                  <TextBlock Classes="body" Text="A few things usually explain it:" />
                  <TextBlock Classes="body" Text="• A vendor app (iCUE, Synapse, G HUB, Armoury Crate) is running and holding on to the device. Close it, then scan again on the Devices page." />
                  <TextBlock Classes="body" Text="• Fans and strips on a controller need their LED count set before they light. The Devices page asks for it." />
                  <TextBlock Classes="body" Text="• The device is off, asleep, or not supported yet. Wake it up; if it still isn't on the Devices page, MyRGB can't light it yet." />
                  <Button Classes="link" Content="Open the Devices page ›" Command="{Binding GoCommand}" CommandParameter="devices" HorizontalAlignment="Left" Margin="-6,0,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
            <Button Classes="link" Content="{Binding Current.ActionLabel, StringFormat='{}{0} ›'}" Command="{Binding GoCommand}"
                    IsVisible="{Binding Current.HasAction}" HorizontalAlignment="Left" Margin="-6,0,0,0" />
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,8,0,0">
              <TextBlock Classes="muted" Text="{Binding Progress}" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="link" Content="Skip tour" Command="{Binding SkipCommand}" HorizontalAlignment="Left" Margin="16,0,0,0" />
              <Button Grid.Column="2" Classes="ghost" Content="Back" Command="{Binding BackCommand}" IsVisible="{Binding !IsFirst}" Margin="0,0,10,0" />
              <Button Grid.Column="3" Classes="accent" Content="{Binding NextLabel}" Command="{Binding NextCommand}" MinWidth="110" HorizontalContentAlignment="Center" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
