<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyRGB.App.ViewModels"
        xmlns:ctl="using:MyRGB.App.Controls"
        xmlns:presets="using:MyRGB.Core.Presets"
        x:Class="MyRGB.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="MyRGB"
        Icon="/Assets/icon.ico"
        Width="1240" Height="800" MinWidth="960" MinHeight="620"
        Background="{StaticResource BaseBrush}">

  <Window.Styles>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.body">
      <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="19" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.kicker">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.2" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18,16" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge > TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
    </Style>
    <Style Selector="Border.iconbox">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{StaticResource AccentWashBrush}" />
    </Style>
    <Style Selector="Border.iconbox > PathIcon">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>
    <!-- Tour check step: round color swatches, the picked one ringed. -->
    <Style Selector="Button.swatch">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.swatch /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
    </Style>
    <Style Selector="Button.swatch.picked">
      <Setter Property="BorderBrush" Value="White" />
    </Style>
    <Style Selector="Button.swatch.picked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="White" />
    </Style>
    <!-- Thin rounded meters for loads and drive space. -->
    <Style Selector="ProgressBar.meter">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="MinHeight" Value="4" />
    </Style>
    <Style Selector="ProgressBar.meter[Orientation=Vertical]">
      <Setter Property="MinWidth" Value="4" />
      <Setter Property="Foreground" Value="{StaticResource LedBlueBrush}" />
    </Style>

    <!-- The supporter badge: a small pink pill. -->
    <Style Selector="Border.supporter">
      <Setter Property="Background" Value="#3A1426" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="7,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.supporter > TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#FF7EB6" />
    </Style>

    <Style Selector="Border.note">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="Padding" Value="6,4" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentWashBrush}" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>

    <!-- Preset cards: the active one is outlined in its own colors and glows. -->
    <Style Selector="Border.cardglow">
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Margin" Value="0,0,16,16" />
      <Setter Property="Transitions">
        <Transitions>
          <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.card">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="212" />
      <Setter Property="Height" Value="146" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
    </Style>
    <Style Selector="Button.card:not(.active):pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
    </Style>
    <Style Selector="Button.card.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
    </Style>
    <Style Selector="Button.chip">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="168" />
      <Setter Property="Height" Value="96" />
      <Setter Property="Margin" Value="0,0,12,12" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>

    <!-- Home device tiles -->
    <Style Selector="Border.tile">
      <Setter Property="Width" Value="248" />
      <Setter Property="Height" Value="146" />
      <Setter Property="Margin" Value="0,0,14,14" />
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="16,14" />
    </Style>

    <!-- Alerts on Home -->
    <Style Selector="Border.alert">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- Sidebar navigation: icon + label, the selected tab is a pill with a gradient edge. -->
    <Style Selector="TabControl.nav > TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Margin" Value="10,2" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="TabControl.nav > TabItem /template/ Border#PART_LayoutRoot">
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="TabControl.nav > TabItem:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="TabControl.nav > TabItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{StaticResource AccentWashBrush}" />
    </Style>
    <Style Selector="TabControl.nav > TabItem:selected">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="TabControl.nav > TabItem:selected /template/ Border#PART_SelectedPipe">
      <Setter Property="Background" Value="{StaticResource RgbGradientVertical}" />
    </Style>
    <Style Selector="TabControl.nav > TabItem PathIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
    </Style>

    <!-- Studio effect chips: raised tiles, the picked one tinted with an accent edge. -->
    <Style Selector="ListBox.chips">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.chips ListBoxItem">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Padding" Value="7,7,7,8" />
    </Style>
    <Style Selector="ListBox.chips ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBox.chips ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
    </Style>
    <Style Selector="ListBox.chips ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentWashBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="ListBox.chips:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
  </Window.Styles>

  <Grid>
    <DockPanel>
      <!-- Top bar: brand, now-playing chip, global controls -->
      <Border DockPanel.Dock="Top" Background="{StaticResource ChromeBrush}" Padding="20,12" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Image Source="/Assets/mark.png" Width="30" Height="30" />
            <TextBlock FontSize="18" FontWeight="ExtraBold" LetterSpacing="-0.4" VerticalAlignment="Center">
              <Run Text="My" /><Run Text="R" Foreground="{StaticResource LedRedBrush}" /><Run Text="G" Foreground="{StaticResource LedGreenBrush}" /><Run Text="B" Foreground="{StaticResource LedBlueBrush}" />
            </TextBlock>
          </StackPanel>

          <Button Grid.Column="2" Classes="ghost" Command="{Binding OpenTourCommand}" Margin="0,0,22,0" VerticalAlignment="Center"
                  ToolTip.Tip="A quick tour of how MyRGB works">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{x:Static ctl:NavIcons.Help}" Width="14" Height="14" />
              <TextBlock Text="How it works" />
            </StackPanel>
          </Button>
          <TextBlock Grid.Column="4" Classes="muted" Text="{Binding Brightness, StringFormat='Brightness {0:0}%'}" VerticalAlignment="Center" Margin="0,0,10,0" />
          <Slider Grid.Column="5" Width="150" Minimum="0" Maximum="100" Value="{Binding Brightness}" VerticalAlignment="Center" Margin="0,0,22,0" />
          <ToggleSwitch Grid.Column="6" IsChecked="{Binding Enabled}" OnContent="Lights on" OffContent="Lights off" VerticalAlignment="Center" />
          <Button Grid.Column="7" Classes="ghost" Command="{Binding NavigateCommand}" CommandParameter="account" Margin="18,0,0,0"
                  VerticalAlignment="Center" IsVisible="{Binding CloudAvailable}" Padding="6,5,12,5" CornerRadius="18"
                  ToolTip.Tip="Your MyRGB account">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource RgbGradient}">
                <TextBlock Text="{Binding Account.Initial}" FontSize="12" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Account.IsSignedIn}" />
              </Border>
              <TextBlock Text="{Binding Account.DisplayName}" VerticalAlignment="Center" IsVisible="{Binding Account.IsSignedIn}"
                         MaxWidth="120" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="Sign in" VerticalAlignment="Center" IsVisible="{Binding !Account.IsSignedIn}" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <!-- Update strip: a newer release is out, one click installs it -->
      <Border DockPanel.Dock="Top" IsVisible="{Binding Update.ShowStrip}"
              Background="{StaticResource AccentWashBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="20,9">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <PathIcon Data="{x:Static ctl:NavIcons.Download}" Width="17" Height="17" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="{Binding Update.Available.Version, StringFormat='MyRGB {0} is available'}" VerticalAlignment="Center" FontWeight="SemiBold" />
            <ProgressBar Classes="meter" Width="150" Maximum="1" Value="{Binding Update.Progress}" IsVisible="{Binding Update.Busy}" VerticalAlignment="Center" />
            <TextBlock Classes="muted" Text="{Binding Update.Status}" VerticalAlignment="Center"
                       IsVisible="{Binding Update.Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding !Update.Busy}">
            <Button Classes="accent" Content="Download and install" Command="{Binding Update.InstallCommand}" />
            <Button Classes="ghost" Content="What's new" Command="{Binding Update.OpenNotesCommand}" />
            <Button Classes="link" Content="Dismiss" Command="{Binding Update.DismissCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Player bar: what's playing, preset transport, and how MyRGB reaches the hardware -->
      <Border DockPanel.Dock="Bottom" Background="{StaticResource ChromeBrush}" Padding="20,10" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="*,Auto,*">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Border Width="40" Height="40" CornerRadius="10" Background="{Binding ActiveSwatch}" />
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <TextBlock Classes="kicker" Text="{Binding PlayingLabel}" />
              <TextBlock Text="{Binding ActivePresetName}" FontSize="14" FontWeight="SemiBold" Foreground="White" MaxWidth="240" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Classes="icon" Command="{Binding EditActiveCommand}" VerticalAlignment="Center" ToolTip.Tip="Edit this in the Studio">
              <PathIcon Data="{x:Static ctl:NavIcons.Studio}" />
            </Button>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Classes="icon" Command="{Binding PreviousPresetCommand}" ToolTip.Tip="Previous preset">
              <PathIcon Data="{x:Static ctl:NavIcons.Previous}" />
            </Button>
            <Button Classes="play" Command="{Binding TogglePauseCommand}" ToolTip.Tip="{Binding PauseTip}">
              <PathIcon Data="{Binding PauseIcon}" />
            </Button>
            <Button Classes="icon" Command="{Binding NextPresetCommand}" ToolTip.Tip="Next preset">
              <PathIcon Data="{x:Static ctl:NavIcons.Next}" />
            </Button>
            <Button Classes="icon" Command="{Binding ShuffleCommand}" ToolTip.Tip="Random preset">
              <PathIcon Data="{x:Static ctl:NavIcons.Shuffle}" />
            </Button>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Ellipse Width="7" Height="7" Fill="{StaticResource RgbGradient}" VerticalAlignment="Center" />
            <TextBlock Classes="muted" Text="{Binding ProviderStatus}" TextTrimming="CharacterEllipsis" MaxWidth="360" />
          </StackPanel>
        </Grid>
      </Border>

      <TabControl Classes="nav" TabStripPlacement="Left" SelectedIndex="{Binding SelectedTab}" Padding="20,22,24,20">

        <!-- ===== Home ===== -->
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="{x:Static ctl:NavIcons.Home}" />
              <TextBlock Text="Home" VerticalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
          <ScrollViewer>
            <StackPanel Spacing="24" Margin="0,0,8,8">
              <StackPanel Spacing="4">
                <TextBlock Classes="h1" Text="Your setup" />
                <TextBlock Classes="muted" Text="{Binding HomeSummary}" />
              </StackPanel>

              <!-- At a glance: what's playing, how the PC is doing, and the fans -->
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                <Border Classes="panel" Padding="16,14">
                  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="kicker" Text="{Binding PlayingLabel}" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="link" Content="Studio ›" Command="{Binding NavigateCommand}" CommandParameter="studio" Margin="0,-6,-8,-6" />
                    </Grid>
                    <Panel Grid.Row="1" Height="64">
                      <ctl:EffectPreview Definition="{Binding ActiveCard.Effect}" Settings="{Binding ActiveCard.Settings}" Animate="{Binding !Paused}"
                                         CornerRadius="8" IsVisible="{Binding ActiveHasEffect}" />
                      <Border Background="{Binding ActiveSwatch}" CornerRadius="8" IsVisible="{Binding !ActiveHasEffect}" />
                    </Panel>
                    <TextBlock Grid.Row="2" Text="{Binding ActivePresetName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </Border>

                <Border Grid.Column="1" Classes="panel" Padding="16,14">
                  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="kicker" Text="SYSTEM" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="link" Content="Monitoring ›" Command="{Binding NavigateCommand}" CommandParameter="monitoring" Margin="0,-6,-8,-6" />
                    </Grid>
                    <StackPanel Grid.Row="1" Spacing="7" VerticalAlignment="Center">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="muted" FontSize="13" Text="CPU" />
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Monitoring.CpuSummary}" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="muted" FontSize="13" Text="GPU" />
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Monitoring.GpuSummary}" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="muted" FontSize="13" Text="Memory" />
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Monitoring.MemorySummary}" />
                      </Grid>
                    </StackPanel>
                    <ctl:Sparkline Grid.Row="2" Values="{Binding Monitoring.Cpu.History}" Color="{Binding Monitoring.Cpu.Color}" Maximum="100" Height="26"
                                   ToolTip.Tip="CPU load, last few minutes" />
                  </Grid>
                </Border>

                <Border Grid.Column="2" Classes="panel" Padding="16,14">
                  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="kicker" Text="COOLING" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="link" Content="Cooling ›" Command="{Binding NavigateCommand}" CommandParameter="cooling" Margin="0,-6,-8,-6" />
                    </Grid>
                    <StackPanel Grid.Row="1" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Cooling.Hottest}" FontSize="30" FontWeight="Bold" Foreground="{Binding Cooling.HottestBrush}" />
                      <TextBlock Classes="muted" FontSize="13" Text="{Binding Cooling.HottestLabel}" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Classes="body" Text="{Binding Cooling.FanSummary}" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </Border>
              </Grid>

              <!-- Things that need attention -->
              <ItemsControl ItemsSource="{Binding Alerts}" IsVisible="{Binding HasAlerts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AlertViewModel">
                    <Border Classes="alert">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <PathIcon Data="{Binding Icon}" Foreground="{Binding Accent}" Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Classes="body" Text="{Binding Text}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Classes="ghost" Content="{Binding ActionLabel}" Command="{Binding Action}"
                                IsVisible="{Binding HasAction}" Margin="12,0,0,0" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Devices -->
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="section" Text="Devices" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="link" Content="Manage devices ›" Command="{Binding NavigateCommand}" CommandParameter="devices" />
                </Grid>
                <Border Classes="panel" IsVisible="{Binding !HasDevices}">
                  <TextBlock Classes="body" Text="Looking for your devices. This takes a few seconds the first time, while OpenRGB scans your hardware." />
                </Border>
                <ItemsControl ItemsSource="{Binding Devices}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeviceRowViewModel">
                      <Border Classes="tile">
                        <Grid RowDefinitions="*,Auto,Auto" RowSpacing="12">
                          <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Top">
                            <Border Classes="iconbox" VerticalAlignment="Top">
                              <PathIcon Data="{Binding Icon}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="1" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                              <TextBlock Classes="muted" Text="{Binding Type}" />
                            </StackPanel>
                            <Button Grid.Column="2" Classes="icon" Command="{Binding FlashCommand}" IsVisible="{Binding CanFlash}" VerticalAlignment="Top"
                                    Margin="6,-4,-6,0" ToolTip.Tip="Flash: pulse this device white so you can spot it">
                              <PathIcon Data="{x:Static ctl:NavIcons.Flash}" />
                            </Button>
                          </Grid>
                          <ctl:DeviceColorsBar Grid.Row="1" Host="{Binding $parent[Window].((vm:MainViewModel)DataContext).Host}" DeviceId="{Binding Id}" Height="10" />
                          <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
                            <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Classes="muted" Text="{Binding StatusText}" Margin="7,0,0,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasBattery}" ToolTip.Tip="{Binding BatteryTip}">
                              <ctl:BatteryGauge Percent="{Binding BatteryPercent}" Charging="{Binding BatteryCharging}" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding BatteryText}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                          </Grid>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Wireless devices MyRGB can read the battery of but doesn't light -->
                <ItemsControl ItemsSource="{Binding OtherBatteries}" IsVisible="{Binding HasOtherBatteries}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BatteryOnlyViewModel">
                      <Border Classes="badge" Margin="0,0,10,10" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Name}" />
                          <ctl:BatteryGauge Percent="{Binding Percent}" Charging="{Binding Charging}" IsVisible="{Binding HasStatus}" />
                          <TextBlock Text="{Binding Text}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- Quick presets -->
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="section" Text="Quick presets" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="link" Content="All presets ›" Command="{Binding NavigateCommand}" CommandParameter="presets" />
                </Grid>
                <ItemsControl ItemsSource="{Binding QuickPresets}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PresetCardViewModel">
                      <Button Classes="chip" Classes.active="{Binding IsActive}" BorderBrush="{Binding Outline}" Command="{Binding ActivateCommand}">
                        <Grid RowDefinitions="*,Auto" Margin="6">
                          <ctl:EffectPreview Definition="{Binding Effect}" Settings="{Binding Settings}" CornerRadius="7" IsVisible="{Binding HasEffect}"
                                             Animate="{Binding $parent[Button].IsPointerOver}" />
                          <Border Background="{Binding Swatch}" CornerRadius="7" IsVisible="{Binding !HasEffect}" />
                          <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Margin="3,6,3,0" TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- How it works -->
              <Border Classes="panel" Padding="22,20" IsVisible="{Binding ShowHomeGuide}">
                <StackPanel Spacing="16">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel Spacing="3">
                      <TextBlock Classes="section" Text="How MyRGB works" />
                      <TextBlock Classes="muted" Text="Four ideas, and you know the whole app." />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="link" Content="Hide" Command="{Binding HideHomeGuideCommand}" VerticalAlignment="Center" Margin="0,0,8,0"
                            ToolTip.Tip="The tour stays under How it works at the top, and in Settings." />
                    <Button Grid.Column="2" Classes="ghost" Content="Take the tour" Command="{Binding OpenTourCommand}" VerticalAlignment="Center" />
                  </Grid>
                  <UniformGrid Columns="4">
                    <StackPanel Spacing="6" Margin="0,0,18,0">
                      <TextBlock Classes="kicker" Text="1 · DEVICES" />
                      <TextBlock FontWeight="SemiBold" Text="It finds your hardware" />
                      <TextBlock Classes="muted" TextWrapping="Wrap" Text="Every brand, through MyRGB's own drivers and the bundled OpenRGB." />
                    </StackPanel>
                    <StackPanel Spacing="6" Margin="0,0,18,0">
                      <TextBlock Classes="kicker" Text="2 · LAYOUT" />
                      <TextBlock FontWeight="SemiBold" Text="Your desk is one canvas" />
                      <TextBlock Classes="muted" TextWrapping="Wrap" Text="Place devices where they sit, and effects flow across all of them." />
                    </StackPanel>
                    <StackPanel Spacing="6" Margin="0,0,18,0">
                      <TextBlock Classes="kicker" Text="3 · PRESETS" />
                      <TextBlock FontWeight="SemiBold" Text="Pick a look, or make one" />
                      <TextBlock Classes="muted" TextWrapping="Wrap" Text="Apply a preset in one click, or tune any effect live in the Studio." />
                    </StackPanel>
                    <StackPanel Spacing="6">
                      <TextBlock Classes="kicker" Text="4 · ANYWHERE" />
                      <TextBlock FontWeight="SemiBold" Text="It runs in the tray" />
                      <TextBlock Classes="muted" TextWrapping="Wrap" Text="Close the window and the lights stay on. Use the tray or a Stream Deck." />
                    </StackPanel>
                  </UniformGrid>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ===== Presets ===== -->
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="{x:Static ctl:NavIcons.Presets}" />
              <TextBlock Text="Presets" VerticalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
              <StackPanel Spacing="4">
                <TextBlock Classes="h1" Text="Presets" />
                <TextBlock Classes="muted" Text="Click a preset to light everything with it. Right-click to edit or delete. Editing a built-in makes your own copy." />
              </StackPanel>
              <Button Grid.Column="1" Classes="accent" Content="+ New preset" Command="{Binding NewPresetCommand}" VerticalAlignment="Center" />
            </Grid>
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Presets}" Margin="0,4,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PresetCardViewModel">
                    <Border Classes="cardglow" BoxShadow="{Binding Glow}">
                      <Button Classes="card" Classes.active="{Binding IsActive}" BorderBrush="{Binding Outline}" Command="{Binding ActivateCommand}">
                        <Button.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Apply" Command="{Binding ActivateCommand}" />
                            <MenuItem Header="Edit in Studio" Command="{Binding EditCommand}" />
                            <MenuItem Header="Delete" Command="{Binding DeleteCommand}" IsVisible="{Binding !IsBuiltIn}" />
                          </ContextMenu>
                        </Button.ContextMenu>
                        <Grid RowDefinitions="*,Auto" Margin="8">
                          <!-- A still of the preset; it plays while hovered or while it's the one on. -->
                          <ctl:EffectPreview Definition="{Binding Effect}" Settings="{Binding Settings}" CornerRadius="9"
                                             IsVisible="{Binding HasEffect}">
                            <ctl:EffectPreview.Animate>
                              <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                <Binding Path="IsActive" />
                                <Binding Path="IsPointerOver" RelativeSource="{RelativeSource AncestorType=Button}" />
                              </MultiBinding>
                            </ctl:EffectPreview.Animate>
                          </ctl:EffectPreview>
                          <Border Background="{Binding Swatch}" CornerRadius="9" IsVisible="{Binding !HasEffect}" />
                          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="4,9,4,1">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Classes="badge">
                              <TextBlock Text="{Binding Badge}" />
                            </Border>
                          </Grid>
                        </Grid>
                      </Button>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </TabItem>

        <!-- ===== Community ===== -->
        <TabItem IsVisible="{Binding CloudAvailable}">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="{x:Static ctl:NavIcons.Community}" />
              <TextBlock Text="Community" VerticalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,16">
              <StackPanel Spacing="4">
                <TextBlock Classes="h1" Text="Community" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="Presets other MyRGB users made. Install one to add it to your presets; anyone can browse, and sharing needs an account." />
              </StackPanel>
              <TextBox Grid.Column="1" Text="{Binding Community.Search}" PlaceholderText="Search presets" Width="220" VerticalAlignment="Center" Margin="16,0,10,0" />
              <ComboBox Grid.Column="2" ItemsSource="{Binding Community.SortOptions}" SelectedItem="{Binding Community.Sort}" VerticalAlignment="Center" MinWidth="150" />
            </Grid>

            <!-- Share one of your own presets -->
            <Border DockPanel.Dock="Top" Classes="panel" Margin="0,0,0,16" Padding="16,12">
              <Grid>
                <StackPanel Spacing="8" IsVisible="{Binding Community.IsSignedIn}">
                  <TextBlock Classes="section" Text="Share a preset" />
                  <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding Community.HasShareable}">
                    <ComboBox ItemsSource="{Binding Community.Shareable}" SelectedItem="{Binding Community.ToShare}" MinWidth="220">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="presets:Preset">
                          <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Text="{Binding Community.ShareDescription}" PlaceholderText="Say something about it (optional)" Width="360" MaxLength="280" />
                    <Button Classes="accent" Content="Share" Command="{Binding Community.ShareCommand}" />
                  </StackPanel>
                  <TextBlock Classes="muted" Text="Make a preset in the Studio first; then you can share it here." IsVisible="{Binding !Community.HasShareable}" />
                  <TextBlock Classes="muted" Text="{Binding Community.ShareStatus}" />
                </StackPanel>
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !Community.IsSignedIn}">
                  <TextBlock Classes="body" Text="Sign in to share your own presets with everyone." VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="ghost" Content="Sign in" Command="{Binding NavigateCommand}" CommandParameter="account" />
                </Grid>
              </Grid>
            </Border>

            <TextBlock DockPanel.Dock="Top" Classes="muted" Text="{Binding Community.Status}" Margin="2,0,0,8" />
            <TextBlock DockPanel.Dock="Top" Classes="body" Text="Nobody has shared a preset that matches yet." IsVisible="{Binding Community.IsEmpty}" />

            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Community.Items}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SharedPresetViewModel">
                    <Border Classes="tile" Height="NaN" Width="260" Padding="10">
                      <StackPanel Spacing="8">
                        <Panel Height="84">
                          <ctl:EffectPreview Definition="{Binding Effect}" Settings="{Binding Settings}" CornerRadius="9"
                                             Animate="{Binding $parent[Border].IsPointerOver}" IsVisible="{Binding Supported}" />
                          <Border Background="{Binding Swatch}" CornerRadius="9" IsVisible="{Binding !Supported}" />
                        </Panel>
                        <StackPanel Spacing="1" Margin="4,0">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="muted">
                              <Run Text="{Binding Author}" />
                              <Run Text=" · " />
                              <Run Text="{Binding Downloads}" />
                            </TextBlock>
                            <Border Classes="supporter" IsVisible="{Binding AuthorSupporter}" ToolTip.Tip="Supports MyRGB"><TextBlock Text="♥" /></Border>
                          </StackPanel>
                          <TextBlock Classes="muted" Text="{Binding Description}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                     IsVisible="{Binding HasDescription}" Margin="0,4,0,0" />
                          <TextBlock Classes="muted" Text="{Binding Unsupported}" Foreground="{StaticResource WarningBrush}" IsVisible="{Binding !Supported}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,0">
                          <Button Classes="accent" Content="Install" Command="{Binding InstallCommand}" />
                          <Button Classes="link" Content="Remove" Command="{Binding RemoveCommand}" IsVisible="{Binding IsMine}" />
                          <Button Classes="link" Content="Report" Command="{Binding AskReportCommand}" IsVisible="{Binding CanReport}" />
                        </StackPanel>
                        <StackPanel Spacing="6" IsVisible="{Binding Reporting}" Margin="2,0">
                          <TextBox Text="{Binding ReportReason}" PlaceholderText="What's wrong with it?" MaxLength="500" />
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Classes="ghost" Content="Send report" Command="{Binding SendReportCommand}" />
                            <Button Classes="link" Content="Cancel" Command="{Binding CancelReportCommand}" />
                          </StackPanel>
                        </StackPanel>
                        <TextBlock Classes="muted" Text="{Binding Status}" TextWrapping="Wrap" Margin="2,0" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </TabItem>

        <!-- ===== Studio (effect editor) ===== -->
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="{x:Static ctl:NavIcons.Studio}" />
              <TextBlock Text="Studio" VerticalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,6">
              <TextBox Text="{Binding Studio.PresetName}" PlaceholderText="Preset name" FontSize="16" />
              <Button Grid.Column="1" Content="Save" Command="{Binding Studio.SaveCommand}" Classes="accent" Margin="10,0,0,0" />
              <Button Grid.Column="2" Classes="ghost" Content="Save as new" Command="{Binding Studio.SaveAsNewCommand}" Margin="8,0,0,0" />
              <Button Grid.Column="3" Classes="ghost" Content="Discard" Command="{Binding Studio.RevertCommand}" Margin="8,0,0,0"
                      ToolTip.Tip="Stop previewing and go back to the preset you had on" />
            </Grid>
            <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="2,0,0,16"
                       Text="Everything you change plays on your devices right away. Save keeps it as a preset." />

            <Grid ColumnDefinitions="*,18,320">
              <!-- Left: the live preview, and the effects to pick from under it. -->
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Classes="kicker" Text="LIVE PREVIEW" Margin="0,0,0,8" />
                <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,16,0,0">
                  <TextBlock Classes="kicker" Text="EFFECT" />
                  <ListBox Classes="chips" ItemsSource="{Binding Studio.Effects}" SelectedItem="{Binding Studio.SelectedEffect}"
                           IsEnabled="{Binding Studio.ShowEffectEditor}" MaxHeight="226" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel ItemWidth="134" />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:EffectItem">
                        <StackPanel ToolTip.Tip="{Binding Description}" Spacing="1">
                          <ctl:EffectPreview Definition="{Binding Definition}" Height="40" Margin="0,0,0,7" />
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="4,0" />
                          <TextBlock Classes="muted" FontSize="11" Text="{Binding Category}" Margin="4,0" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
                <ctl:LedCanvas Host="{Binding Host}" HighlightId="{Binding Studio.SelectedTarget.DeviceId}" MinHeight="180" />
              </DockPanel>

              <!-- Right: what's being edited, and its settings. -->
              <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Classes="panel" Padding="16,14" Margin="0,0,0,14">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="kicker" Text="EDIT FOR" />
                    <ComboBox ItemsSource="{Binding Studio.Targets}" SelectedItem="{Binding Studio.SelectedTarget}" HorizontalAlignment="Stretch" />
                    <ComboBox ItemsSource="{Binding Studio.Modes}" SelectedItem="{Binding Studio.TargetMode}" HorizontalAlignment="Stretch"
                              IsVisible="{Binding Studio.IsDeviceTarget}" />
                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Studio.TargetHint}" />
                  </StackPanel>
                </Border>

                <Border Classes="panel" Padding="16,14">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,12">
                      <TextBlock Classes="section" Text="{Binding Studio.SettingsTitle}" />
                      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Studio.SettingsDescription}"
                                 IsVisible="{Binding Studio.SettingsDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="body" Foreground="{StaticResource MutedBrush}" Text="{Binding Studio.SettingsHint}"
                               IsVisible="{Binding !Studio.HasParameters}" />
                    <ScrollViewer>
                      <ItemsControl ItemsSource="{Binding Studio.Parameters}">
                        <ItemsControl.DataTemplates>
                          <DataTemplate DataType="vm:ColorParameterViewModel">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,10">
                              <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                              <ColorPicker Grid.Column="1" Color="{Binding Color}" IsAlphaVisible="False" />
                            </Grid>
                          </DataTemplate>
                          <DataTemplate DataType="vm:NumberParameterViewModel">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,4,0,6">
                              <TextBlock Text="{Binding Label}" />
                              <TextBlock Grid.Column="1" Text="{Binding Display}" FontFamily="{StaticResource BrandMono}" FontSize="12"
                                         Foreground="{StaticResource InkSecondaryBrush}" />
                              <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="{Binding Min}" Maximum="{Binding Max}" SmallChange="{Binding Step}"
                                      TickFrequency="{Binding Step}" IsSnapToTickEnabled="True" Value="{Binding Value}" />
                            </Grid>
                          </DataTemplate>
                          <DataTemplate DataType="vm:ChoiceParameterViewModel">
                            <StackPanel Spacing="6" Margin="0,4,0,12">
                              <TextBlock Text="{Binding Label}" />
                              <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                          </DataTemplate>
                          <DataTemplate DataType="vm:BoolParameterViewModel">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,8">
                              <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Value}" OnContent="" OffContent="" MinWidth="0" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.DataTemplates>
                      </ItemsControl>
                    </ScrollViewer>
                  </DockPanel>
                </Border>
              </DockPanel>
            </Grid>
          </DockPanel>
        </TabItem>

        <!-- ===== Layout ===== -->
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="{x:Static ctl:NavIcons.Layout}" />
              <TextBlock Text="Layout" VerticalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
              <StackPanel Spacing="4">
                <TextBlock Classes="h1" Text="Layout" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="This rectangle is your desk seen from the front. Drag each device to where it really sits, and drag a corner to resize it. Effects sweep across the whole picture, so a good layout makes waves flow from one device to the next." />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                <Button Classes="ghost" Content="Tidy up" Command="{Binding TidyLayoutCommand}"
                        ToolTip.Tip="Nudge overlapping devices apart and leave the rest where they are" />
                <Button Classes="ghost" Content="Reset layout" Command="{Binding ResetLayoutCommand}"
                        ToolTip.Tip="Put every device back in its default spot" />
              </StackPanel>
            </Grid>
            <ctl:LedCanvas Host="{Binding Host}" AllowEditing="True" />
          </DockPanel>
        </TabItem>

        <!-- ===== Devices ===== -->
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="{x:Static ctl:NavIcons.Devices}" />
              <TextBlock Text="Devices" VerticalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
              <StackPanel Spacing="4">
                <TextBlock Classes="h1" Text="Devices" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Text="Everything MyRGB found. Switch a device off to leave it alone, for example so another app can light it." />
              </StackPanel>
              <Button Grid.Column="1" Classes="ghost" Content="Scan again" Command="{Binding RescanCommand}" IsEnabled="{Binding !IsScanning}" VerticalAlignment="Center" />
            </Grid>
            <ScrollViewer>
              <StackPanel Spacing="10" Margin="0,0,8,8">
                <ItemsControl ItemsSource="{Binding Devices}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeviceRowViewModel">
                      <Border Classes="panel" Margin="0,0,0,8" Padding="16,12">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <Border Classes="iconbox" VerticalAlignment="Top">
                            <PathIcon Data="{Binding Icon}" />
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="6" Margin="14,0,16,0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                              <Border Classes="badge"><TextBlock Text="{Binding LedBadge}" /></Border>
                              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasBattery}" ToolTip.Tip="{Binding BatteryTip}">
                                <ctl:BatteryGauge Percent="{Binding BatteryPercent}" Charging="{Binding BatteryCharging}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding BatteryText}" FontSize="12" VerticalAlignment="Center" />
                              </StackPanel>
                            </StackPanel>
                            <TextBlock Classes="muted">
                              <Run Text="{Binding Vendor}" />
                              <Run Text=" · " />
                              <Run Text="{Binding Type}" />
                              <Run Text=" · " />
                              <Run Text="{Binding Connection}" />
                            </TextBlock>
                            <TextBlock Classes="muted" Text="{Binding Zones}" TextWrapping="Wrap" IsVisible="{Binding ShowZones}" />
                            <ctl:DeviceColorsBar Host="{Binding $parent[Window].((vm:MainViewModel)DataContext).Host}" DeviceId="{Binding Id}"
                                                 Height="6" HorizontalAlignment="Left" Width="320" Margin="0,2,0,0" IsVisible="{Binding !NeedsSetup}" />
                            <ItemsControl ItemsSource="{Binding ResizableZones}" IsVisible="{Binding HasResizableZones}" Margin="0,4,0,0">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ZoneSizeViewModel">
                                  <Grid ColumnDefinitions="180,Auto,Auto,Auto" Margin="0,3">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding LedCount}" Minimum="{Binding Min}" Maximum="{Binding Max}"
                                                   Increment="1" FormatString="0" Width="130" />
                                    <TextBlock Grid.Column="2" Classes="muted" Text="{Binding Range}" VerticalAlignment="Center" Margin="10,0" />
                                    <Button Grid.Column="3" Classes="accent" Content="Apply" Command="{Binding ApplyCommand}" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                          <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Right">
                            <ToggleSwitch IsChecked="{Binding Included}" OnContent="MyRGB controls it" OffContent="Left alone" />
                            <Button Classes="ghost" Command="{Binding FlashCommand}" IsVisible="{Binding CanFlash}" HorizontalAlignment="Right"
                                    ToolTip.Tip="Pulse this device white for a few seconds, so you can see which one it is">
                              <StackPanel Orientation="Horizontal" Spacing="7">
                                <PathIcon Data="{x:Static ctl:NavIcons.Flash}" Width="14" Height="14" />
                                <TextBlock Text="Flash" />
                              </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" IsVisible="{Binding NeedsSetup}">
                              <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                              <TextBlock Classes="muted" Text="{Binding StatusText}" />
                            </StackPanel>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Classes="panel">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="section" Text="Something missing?" />
                    <TextBlock Classes="body" Text="• A brand app may be holding it. Corsair devices often vanish while iCUE runs. Quit the app (check the system tray too) and click Scan again. The Vendor apps page shows which ones are installed." />
                    <TextBlock Classes="body" Text="• Fan and LED-strip controllers can't tell how many LEDs are plugged in. Set each channel's count on the device above (LEDs per fan × number of fans, e.g. 16 for one LL120)." />
                    <TextBlock Classes="body" Text="• RGB RAM needs the optional SMBus driver. Run MyRGB setup again and tick “Enable RAM / SMBus lighting”." />
                    <Button Classes="link" Content="Open Vendor apps ›" Command="{Binding NavigateCommand}" CommandParameter="vendors" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>

                <!-- Will it work with my device? -->
                <Border Classes="panel" DataContext="{Binding Supported}" x:DataType="vm:SupportedDevicesViewModel">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="section" Text="Will MyRGB work with my device?" />
                    <TextBox Text="{Binding Query}" PlaceholderText="Search, e.g. corsair k70 or rtx 4070" />
                    <TextBlock Classes="muted" Text="{Binding Summary}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Results}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SupportedDevice">
                          <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Connection}" Margin="12,0,0,0" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </TabItem>

        <!-- ===== Monitoring ===== -->
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="{x:Static ctl:NavIcons.Monitoring}" />
              <TextBlock Text="Monitoring" VerticalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
          <DockPanel DataContext="{Binding Monitoring}" x:DataType="vm:MonitoringViewModel">
            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,20">
              <TextBlock Classes="h1" Text="Monitoring" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="Live readings from your PC, once a second, with the last five minutes charted. Nothing leaves this computer." />
            </StackPanel>
            <ScrollViewer>
              <StackPanel Spacing="14" Margin="0,0,8,8">
                <Border Classes="panel" IsVisible="{Binding !HasReadings}">
                  <TextBlock Classes="body" Text="Reading your sensors…" />
                </Border>

                <ItemsControl ItemsSource="{Binding Cards}" IsVisible="{Binding HasReadings}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MetricCard">
                      <Border Classes="panel" Margin="0,0,14,14" Padding="18,16,18,14">
                        <StackPanel Spacing="10">
                          <Grid ColumnDefinitions="Auto,*">
                            <Ellipse Width="8" Height="8" Fill="{Binding Accent}" VerticalAlignment="Center" Margin="0,0,9,0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                              <TextBlock Classes="section" Text="{Binding Title}" />
                              <TextBlock Classes="muted" Text="{Binding Subtitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </Grid>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Value}" FontSize="34" FontWeight="Bold" LetterSpacing="-1" />
                            <TextBlock Classes="muted" Text="{Binding Unit}" FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,7" />
                          </StackPanel>
                          <ctl:Sparkline Values="{Binding History}" Color="{Binding Color}" Maximum="{Binding Max}" Height="64" />
                          <ItemsControl ItemsSource="{Binding Lines}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:MetricLine">
                                <StackPanel Margin="0,0,22,0" Spacing="1">
                                  <TextBlock Classes="kicker" Text="{Binding Label}" />
                                  <TextBlock Text="{Binding Value}" FontFamily="{StaticResource BrandMono}" FontSize="13" />
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid ColumnDefinitions="*,14,*" IsVisible="{Binding HasReadings}" Margin="0,-14,14,0">
                  <Border Classes="panel">
                    <StackPanel Spacing="12">
                      <TextBlock Classes="section" Text="CPU threads" />
                      <ItemsControl ItemsSource="{Binding Threads}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ThreadLoad">
                            <ProgressBar Classes="meter" Orientation="Vertical" Minimum="0" Maximum="100" Value="{Binding Percent}"
                                         Height="70" MinWidth="0" Margin="2,0" ToolTip.Tip="{Binding Percent, StringFormat='{}{0:0} %'}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="2" Classes="panel">
                    <StackPanel Spacing="12">
                      <TextBlock Classes="section" Text="Drives" />
                      <ItemsControl ItemsSource="{Binding Drives}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:DriveViewModel">
                            <StackPanel Spacing="5" Margin="0,0,0,10">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Detail}" />
                              </Grid>
                              <ProgressBar Classes="meter" Minimum="0" Maximum="100" Value="{Binding Percent}" Height="6" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </Grid>

                <Border Classes="panel" Margin="0,0,14,0" IsVisible="{Binding HasReadings}">
                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Classes="section" Text="Every sensor" />
                        <TextBlock Classes="muted" Text="The full list, straight from the hardware." />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowAll}" OnContent="Shown" OffContent="Hidden" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding AllSensors}" IsVisible="{Binding ShowAll}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SensorRow">
                          <Grid ColumnDefinitions="260,*,Auto" Margin="0,2">
                            <TextBlock Classes="muted" Text="{Binding Hardware}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding Value}" FontFamily="{StaticResource BrandMono}" FontSize="12" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </TabItem>

        <!-- ===== Cooling ===== -->
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="{x:Static ctl:NavIcons.Cooling}" />
              <TextBlock Text="Cooling" VerticalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
          <DockPanel DataContext="{Binding Cooling}" x:DataType="vm:CoolingViewModel">
            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,20">
              <TextBlock Classes="h1" Text="Cooling" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="Temperatures, and fans MyRGB drives for you. Give any fan a fixed speed or a curve; anything you leave on Automatic runs on its hardware default." />
            </StackPanel>
            <ScrollViewer>
              <StackPanel Spacing="14" Margin="0,0,8,8">
                <ItemsControl ItemsSource="{Binding Temps}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TempGauge">
                      <Border Classes="panel" Margin="0,0,14,0" Padding="16,14">
                        <StackPanel Spacing="6">
                          <TextBlock Classes="kicker" Text="{Binding Label}" />
                          <TextBlock Text="{Binding Value}" FontSize="30" FontWeight="Bold" Foreground="{Binding Brush}" IsVisible="{Binding Available}" />
                          <TextBlock Text="needs admin" FontSize="15" Foreground="{StaticResource SubtleBrush}" IsVisible="{Binding !Available}" Margin="0,8,0,9" />
                          <ProgressBar Classes="meter" Minimum="0" Maximum="100" Value="{Binding Percent}" Height="5" Foreground="{Binding Brush}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Classes="note" Margin="0,0,14,0">
                  <Grid ColumnDefinitions="Auto,*">
                    <PathIcon Data="{x:Static ctl:NavIcons.Check}" Width="16" Height="16" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Top" Margin="0,1,10,0" />
                    <TextBlock Grid.Column="1" Classes="body" Text="{Binding SafetyText}" />
                  </Grid>
                </Border>

                <Border Classes="panel" Margin="0,0,14,0" IsVisible="{Binding NeedsAdmin}">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="section" Text="Fan control needs administrator" />
                    <TextBlock Classes="body" IsVisible="{Binding !HelperConnected}"
                               Text="Your CPU's temperature and the fans on your motherboard are only readable for programs running as administrator. One Windows permission prompt sets up a small helper that reads them for MyRGB, which carries on running normally without any." />
                    <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding !HelperConnected}">
                      <Button Classes="accent" Content="Enable CPU temperatures and fans" Command="{Binding EnableHelperCommand}"
                              ToolTip.Tip="Windows asks for permission once. MyRGB keeps running; temperatures appear within a few seconds." />
                      <Button Classes="ghost" Content="Restart as administrator" Command="{Binding RestartAsAdminCommand}"
                              ToolTip.Tip="Windows asks for permission, then MyRGB reopens with admin rights and takes over from this one." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HelperConnected}">
                      <PathIcon Data="{x:Static ctl:NavIcons.Check}" Width="16" Height="16" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                      <TextBlock Classes="body" VerticalAlignment="Center" TextWrapping="Wrap"
                                 Text="The helper is running: CPU temperatures and fan control are on. It starts with Windows, and uninstalling MyRGB removes it." />
                      <Button Classes="link" Content="Turn off" Command="{Binding TurnOffHelperCommand}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Spacing="10" IsVisible="{Binding HelperOutdated}">
                      <TextBlock Classes="body" TextWrapping="Wrap"
                                 Text="The helper is an older version than this MyRGB. One more permission prompt brings it up to date; your fan settings stay as they are." />
                      <Button Classes="ghost" Content="Update the helper" Command="{Binding EnableHelperCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                    <TextBlock Classes="muted" Text="{Binding AdminStatus}" TextWrapping="Wrap"
                               IsVisible="{Binding AdminStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,14,10" IsVisible="{Binding HasFans}">
                  <TextBlock Classes="muted" Text="{Binding FanSummary}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="ghost" Content="All automatic" Command="{Binding AllAutomaticCommand}"
                          ToolTip.Tip="Every fan back to its hardware default" Margin="0,0,10,0" />
                  <ToggleSwitch Grid.Column="2" IsChecked="{Binding GridView}" OnContent="Grid" OffContent="List" VerticalAlignment="Center" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Fans}" IsVisible="{Binding !GridView}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FanRowViewModel">
                      <Border Classes="panel" Margin="0,0,14,14">
                        <StackPanel Spacing="12">
                          <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="iconbox"><PathIcon Data="{x:Static ctl:NavIcons.Cooling}" /></Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="1">
                              <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                                <Border Classes="badge"><TextBlock Text="{Binding Speed}" /></Border>
                              </StackPanel>
                              <TextBlock Classes="muted" Text="{Binding Status}" />
                            </StackPanel>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" MinWidth="170" VerticalAlignment="Center" />
                          </Grid>
                          <TextBlock Classes="muted" Text="{Binding ModeHint}" />

                          <!-- One click from automatic to a working curve. -->
                          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsAuto}">
                            <TextBlock Classes="muted" Text="Make it a curve:" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <Button Classes="ghost" Content="Silent" Command="{Binding QuickCurveCommand}" CommandParameter="silent" />
                            <Button Classes="ghost" Content="Quiet" Command="{Binding QuickCurveCommand}" CommandParameter="quiet" />
                            <Button Classes="ghost" Content="Balanced" Command="{Binding QuickCurveCommand}" CommandParameter="balanced" />
                            <Button Classes="ghost" Content="Performance" Command="{Binding QuickCurveCommand}" CommandParameter="performance" />
                            <Button Classes="ghost" Content="Full speed" Command="{Binding QuickCurveCommand}" CommandParameter="full" />
                          </StackPanel>

                          <Grid ColumnDefinitions="*,60" IsVisible="{Binding IsFixed}">
                            <Slider Minimum="0" Maximum="100" Value="{Binding FixedPercent}" TickFrequency="1" IsSnapToTickEnabled="True" />
                            <TextBlock Grid.Column="1" Text="{Binding FixedPercent, StringFormat='{}{0:0} %'}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontFamily="{StaticResource BrandMono}" />
                          </Grid>

                          <StackPanel Spacing="10" IsVisible="{Binding IsCurve}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                              <TextBlock Text="Follows" VerticalAlignment="Center" />
                              <ComboBox ItemsSource="{Binding Follow}" SelectedItem="{Binding Sensor}" MinWidth="220" />
                            </StackPanel>
                            <ctl:FanCurveChart Points="{Binding Points}" CurrentTemp="{Binding CurrentTemp}" Height="230" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Classes="muted" Text="Presets:" VerticalAlignment="Center" Margin="0,0,4,0" />
                              <Button Classes="ghost" Content="Silent" Command="{Binding SilentCommand}" />
                              <Button Classes="ghost" Content="Quiet" Command="{Binding QuietCommand}" />
                              <Button Classes="ghost" Content="Balanced" Command="{Binding BalancedCommand}" />
                              <Button Classes="ghost" Content="Performance" Command="{Binding PerformanceCommand}" />
                              <Button Classes="ghost" Content="Full speed" Command="{Binding FullSpeedCommand}" />
                            </StackPanel>
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Grid view: compact tiles for switching several fans at a glance.
                     The chart stays in the list view; tiles carry name, speed and mode. -->
                <ItemsControl ItemsSource="{Binding Fans}" IsVisible="{Binding GridView}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FanRowViewModel">
                      <Border Classes="panel" Width="264" Margin="0,0,12,12" Padding="14,12">
                        <StackPanel Spacing="8">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" ToolTip.Tip="{Binding Name}" />
                            <Border Grid.Column="1" Classes="badge"><TextBlock Text="{Binding Speed}" /></Border>
                          </Grid>
                          <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                          <TextBlock Classes="muted" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Classes="panel" Margin="0,0,14,0" IsVisible="{Binding !HasFans}">
                  <TextBlock Classes="body" Text="MyRGB hasn't found a fan it can control yet." />
                </Border>

              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </TabItem>

        <!-- ===== Vendor apps ===== -->
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="{x:Static ctl:NavIcons.Vendors}" />
              <TextBlock Text="Vendor apps" VerticalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
              <StackPanel Spacing="4">
                <TextBlock Classes="h1" Text="Vendor apps" />
                <TextBlock Classes="muted" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left"
                           Text="Brand apps like iCUE, G HUB and Armoury Crate also try to control your lights, and they fight with MyRGB. Once MyRGB runs a brand's devices you can usually uninstall its app. Here's what's on this PC, and what each app does that MyRGB doesn't." />
              </StackPanel>
              <Button Grid.Column="1" Classes="ghost" Content="Check again" Command="{Binding Vendors.CheckCommand}" IsEnabled="{Binding !Vendors.IsChecking}" VerticalAlignment="Center" Margin="16,0,0,0" />
            </Grid>
            <ScrollViewer>
              <StackPanel Spacing="14" Margin="0,0,8,8" MaxWidth="900" HorizontalAlignment="Left">
                <Border Classes="panel" IsVisible="{Binding Vendors.NothingFound}">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{x:Static ctl:NavIcons.Check}" Foreground="{StaticResource SuccessBrush}" Width="18" Height="18" />
                    <TextBlock Classes="body" Text="No vendor lighting apps found. Nothing to clean up." VerticalAlignment="Center" />
                  </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Vendors.Apps}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:VendorAppViewModel">
                      <Border Classes="panel" Margin="0,0,0,14" Padding="22,18">
                        <StackPanel Spacing="12">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                              <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" />
                              <TextBlock Classes="muted">
                                <Run Text="{Binding Version}" />
                                <Run Text="  ·  " />
                                <Run Text="{Binding RunningText}" />
                              </TextBlock>
                            </StackPanel>
                            <Border Grid.Column="1" Classes="badge" Padding="10,4" VerticalAlignment="Top">
                              <StackPanel Orientation="Horizontal" Spacing="7">
                                <Ellipse Width="8" Height="8" Fill="{Binding VerdictBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding VerdictTitle}" FontSize="12" Foreground="White" />
                              </StackPanel>
                            </Border>
                          </Grid>

                          <TextBlock Classes="body" Text="{Binding Verdict}" />

                          <StackPanel Spacing="6" IsVisible="{Binding HasControlledDevices}">
                            <TextBlock Classes="kicker" Text="MYRGB NOW RUNS" />
                            <ItemsControl ItemsSource="{Binding ControlledDevices}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                  <Border Classes="badge" Margin="0,0,6,6"><TextBlock Text="{Binding}" /></Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>

                          <StackPanel Spacing="6" IsVisible="{Binding HasLosses}">
                            <TextBlock Classes="kicker" Text="WHAT MYRGB DOESN'T REPLACE" />
                            <ItemsControl ItemsSource="{Binding YouWouldLose}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                  <TextBlock Classes="body" Text="{Binding StringFormat='• {0}'}" Margin="0,1" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>

                          <Border Background="{StaticResource InfoWashBrush}" CornerRadius="8" Padding="12,9" IsVisible="{Binding HasTip}">
                            <Grid ColumnDefinitions="Auto,*">
                              <PathIcon Data="{x:Static ctl:NavIcons.Info}" Foreground="{StaticResource InfoBrush}" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,10,0" />
                              <TextBlock Grid.Column="1" Classes="body" Text="{Binding Tip}" />
                            </Grid>
                          </Border>

                          <StackPanel Spacing="6" IsVisible="{Binding HasComponents}">
                            <TextBlock Classes="kicker" Text="INSTALLED ALONG WITH IT" />
                            <ItemsControl ItemsSource="{Binding Components}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ComponentViewModel">
                                  <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                    <TextBlock Classes="body" Text="{Binding Name}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="link" Content="Uninstall" Command="{Binding UninstallCommand}" IsVisible="{Binding CanUninstall}" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>

                          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding !Confirming}">
                            <Button Classes="accent" Content="{Binding Name, StringFormat='Uninstall {0}…'}" Command="{Binding AskUninstallCommand}" IsVisible="{Binding CanUninstall}" />
                          </StackPanel>
                          <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" IsVisible="{Binding Confirming}">
                            <StackPanel Spacing="10">
                              <TextBlock Classes="body" TextWrapping="Wrap"
                                         Text="{Binding Name, StringFormat='This opens {0}’s own uninstaller. Windows will probably ask for permission. Your MyRGB presets and settings are not affected.'}" />
                              <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Classes="accent" Content="Open uninstaller" Command="{Binding UninstallCommand}" />
                                <Button Classes="ghost" Content="Cancel" Command="{Binding CancelUninstallCommand}" />
                              </StackPanel>
                            </StackPanel>
                          </Border>
                          <TextBlock Classes="muted" Text="{Binding Status}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </TabItem>

        <!-- ===== Settings ===== -->
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="{x:Static ctl:NavIcons.Settings}" />
              <TextBlock Text="Settings" VerticalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
          <ScrollViewer>
            <StackPanel Spacing="14" MaxWidth="760" HorizontalAlignment="Left">
              <TextBlock Classes="h1" Text="Settings" Margin="0,0,0,6" />

              <!-- Account (only in builds with the account service) -->
              <Border Classes="panel" IsVisible="{Binding CloudAvailable}">
                <StackPanel Spacing="12">
                  <TextBlock Classes="section" Text="Account" />

                  <StackPanel Spacing="10" IsVisible="{Binding Account.IsSignedOut}">
                    <TextBlock Classes="body" Text="An account is optional. Sign in to keep your presets in sync across PCs, share presets with the community, and contact Root Labs. MyRGB never sees your password: you sign in on the provider's own page in your browser." />
                    <ItemsControl ItemsSource="{Binding Account.Providers}" IsEnabled="{Binding !Account.IsBusy}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProviderButton">
                          <Button Classes="ghost" Content="{Binding Label}" Command="{Binding Command}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding Account.IsBusy}">
                      <TextBlock Classes="muted" Text="{Binding Account.Status}" VerticalAlignment="Center" />
                      <Button Classes="link" Content="Cancel" Command="{Binding Account.CancelSignInCommand}" />
                    </StackPanel>
                  </StackPanel>

                  <StackPanel Spacing="12" IsVisible="{Binding Account.IsSignedIn}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource RgbGradient}">
                        <TextBlock Text="{Binding Account.Initial}" FontSize="17" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Account.DisplayName}" FontWeight="SemiBold" />
                        <TextBlock Classes="muted">
                          <Run Text="{Binding Account.Email}" />
                          <Run Text="  ·  " />
                          <Run Text="{Binding Account.ProviderText}" />
                        </TextBlock>
                      </StackPanel>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                      <ToggleSwitch IsChecked="{Binding Account.SyncPresets}" OnContent="Sync my presets across PCs" OffContent="Sync my presets across PCs" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Classes="muted" Text="{Binding Account.SyncStatus}" VerticalAlignment="Center" />
                        <Button Classes="ghost" Content="Sync now" Command="{Binding Account.SyncNowCommand}" IsEnabled="{Binding Account.SyncPresets}" />
                      </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding !Account.ConfirmingDelete}">
                      <Button Classes="ghost" Content="Sign out" Command="{Binding Account.SignOutCommand}" />
                      <Button Classes="link" Content="Delete my account…" Command="{Binding Account.AskDeleteCommand}" Foreground="{StaticResource DangerBrush}" />
                    </StackPanel>
                    <Border Background="{StaticResource DangerWashBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" IsVisible="{Binding Account.ConfirmingDelete}">
                      <StackPanel Spacing="10">
                        <TextBlock Classes="body" Text="This permanently deletes your account, your synced presets and any presets you shared. Presets on this PC stay. It can't be undone." />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <Button Classes="ghost" Content="Delete my account" Command="{Binding Account.DeleteAccountCommand}" Foreground="{StaticResource DangerBrush}" />
                          <Button Classes="link" Content="Cancel" Command="{Binding Account.CancelDeleteCommand}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  <TextBlock Classes="muted" Text="{Binding Account.Status}" TextWrapping="Wrap" IsVisible="{Binding !Account.IsBusy}" />
                </StackPanel>
              </Border>

              <!-- Supporting MyRGB: every feature is free; support funds the work and the servers. -->
              <Border Classes="panel">
                <Border.IsVisible>
                  <MultiBinding Converter="{x:Static BoolConverters.Or}">
                    <Binding Path="Account.HasSupportLinks" />
                    <Binding Path="Account.IsSupporter" />
                  </MultiBinding>
                </Border.IsVisible>
                <StackPanel Spacing="10">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="section" Text="Support MyRGB" />
                    <Border Classes="supporter" IsVisible="{Binding Account.IsSupporter}"><TextBlock Text="♥ Supporter" /></Border>
                  </StackPanel>
                  <TextBlock Classes="body" Text="MyRGB is free and open source, and every feature in it, fan control included, stays free. If it replaced a few vendor apps for you, chipping in keeps it going: it pays for the servers behind sync and the community, and for time to support more hardware." />
                  <TextBlock Classes="body" Text="Supporters get a badge on the presets they share, and room to sync up to 200 presets and share up to 15 (everyone gets 50 and 5)." />
                  <TextBlock Classes="body" Foreground="{StaticResource AccentBrush}" Text="{Binding Account.SupporterText}" IsVisible="{Binding Account.IsSupporter}" />
                  <ToggleSwitch IsChecked="{Binding Account.ShowBadge}" IsVisible="{Binding Account.IsSupporter}"
                                OnContent="Show my supporter badge on shared presets" OffContent="Show my supporter badge on shared presets" />
                  <ItemsControl ItemsSource="{Binding Account.SupportLinks}" IsVisible="{Binding Account.HasSupportLinks}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:LinkButton">
                        <Button Classes="accent" Content="{Binding Label}" Command="{Binding Command}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding Account.HasSupportLinks}"
                             Text="Support with the same email as your MyRGB account, so your perks can be matched to it." />
                </StackPanel>
              </Border>

              <Border Classes="panel">
                <StackPanel Spacing="10">
                  <TextBlock Classes="section" Text="Startup" />
                  <ToggleSwitch IsChecked="{Binding StartWithWindows}" OnContent="Start with Windows" OffContent="Start with Windows" />
                  <ToggleSwitch IsChecked="{Binding StartMinimized}" OnContent="Start hidden in the tray" OffContent="Start hidden in the tray" />
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="Closing the window never quits MyRGB; it keeps your lights running from the tray. Quit from the tray icon's menu." />
                </StackPanel>
              </Border>

              <!-- Updates: quiet checks against the project's GitHub releases -->
              <Border Classes="panel">
                <StackPanel Spacing="10">
                  <TextBlock Classes="section" Text="Updates" />
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <ToggleSwitch IsChecked="{Binding CheckForUpdates}" OnContent="Check for updates when MyRGB starts" OffContent="Check for updates when MyRGB starts" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Update.VersionText}" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Classes="ghost" Content="Check now" Command="{Binding Update.CheckCommand}" IsEnabled="{Binding !Update.Busy}" />
                  </Grid>
                  <TextBlock Classes="muted" Text="{Binding Update.Status}" TextWrapping="Wrap"
                             IsVisible="{Binding Update.Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="Updates download from the project's GitHub releases and install in place; Windows never asks for permission. A download is checked against the checksum published with the release before it runs." />
                </StackPanel>
              </Border>

              <Border Classes="panel">
                <StackPanel Spacing="10">
                  <TextBlock Classes="section" Text="Smoothness" />
                  <Grid ColumnDefinitions="200,*,60">
                    <TextBlock Text="Updates per second" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Minimum="10" Maximum="60" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Fps}" />
                    <TextBlock Grid.Column="2" Text="{Binding Fps}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                  </Grid>
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="30 looks smooth for every effect. Higher uses more USB bandwidth, and some wireless devices can't keep up." />
                </StackPanel>
              </Border>

              <Border Classes="panel">
                <StackPanel Spacing="8">
                  <TextBlock Classes="section" Text="Stream Deck" />
                  <TextBlock Classes="body" Text="{Binding StreamDeckStatus}" />
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="Keys can switch presets (showing each preset's colors), turn the lights on and off, and change brightness." />
                </StackPanel>
              </Border>

              <Border Classes="panel">
                <StackPanel Spacing="10">
                  <TextBlock Classes="section" Text="Help" />
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Classes="ghost" Content="Show the welcome tour" Command="{Binding OpenTourCommand}" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                    <StackPanel Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0">
                      <TextBlock Text="Get in touch" FontWeight="SemiBold" />
                      <TextBlock Classes="muted" TextWrapping="Wrap" Text="Questions, bugs, or a device you'd like supported? Reach Root Labs through our website." />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="accent" Content="Visit rootlabs.us ›" Command="{Binding OpenWebsiteCommand}"
                            VerticalAlignment="Center" ToolTip.Tip="{x:Static vm:MainViewModel.WebsiteUrl}" />
                  </Grid>
                </StackPanel>
              </Border>

              <Expander Header="Advanced" HorizontalAlignment="Stretch" CornerRadius="12"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource HairlineBrush}">
                <StackPanel Spacing="14" Margin="0,6,0,0">
                  <StackPanel Spacing="6">
                    <TextBlock Text="OpenRGB program" FontWeight="SemiBold" />
                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="MyRGB starts OpenRGB out of sight to reach most devices. Change this only if you use your own copy. Takes effect the next time MyRGB starts." />
                    <TextBox Text="{Binding OpenRgbPath}" PlaceholderText="Path to OpenRGB.exe" />
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <TextBlock Text="Local API (for scripts and the Stream Deck plugin)" FontWeight="SemiBold" />
                    <SelectableTextBlock Text="{Binding ApiUrl}" FontFamily="{StaticResource BrandMono}" />
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <TextBlock Text="Log file" FontWeight="SemiBold" />
                    <SelectableTextBlock Text="{Binding LogPath}" FontFamily="{StaticResource BrandMono}" />
                  </StackPanel>
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </DockPanel>

    <!-- ===== Support note: bottom right, above the player bar, after a week of use ===== -->
    <Border IsVisible="{Binding SupportNudge.IsOpen}" Width="330" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,84"
            Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
            CornerRadius="14" ClipToBounds="True" BoxShadow="0 16 40 0 #90000000">
      <StackPanel>
        <Border Height="3" Background="{StaticResource RgbGradient}" />
        <StackPanel Margin="18,14,18,14" Spacing="6">
          <TextBlock Classes="section" Text="Like MyRGB?" />
          <TextBlock Classes="body" Text="Buy the devs a cup of joe; it keeps them going." />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
            <Button Classes="accent" Content="Buy a coffee" Command="{Binding SupportNudge.SupportCommand}" />
            <Button Classes="ghost" Content="Maybe later" Command="{Binding SupportNudge.LaterCommand}" />
          </StackPanel>
          <Button Classes="link" Content="Don't ask again" Command="{Binding SupportNudge.NeverCommand}" HorizontalAlignment="Left" Margin="-6,0,0,0" FontSize="12" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ===== First-run tour (also opened from "How it works") ===== -->
    <Border IsVisible="{Binding ShowWelcome}" Background="{StaticResource OverlayBrush}">
      <Border Width="640" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
              CornerRadius="18" ClipToBounds="True" BoxShadow="0 24 70 0 #A0000000"
              DataContext="{Binding Welcome}" x:DataType="vm:WelcomeViewModel">
        <StackPanel>
          <Border Height="4" Background="{StaticResource RgbGradient}" />
          <StackPanel Margin="40,34,40,28" Spacing="16">
            <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource RgbGradient}" HorizontalAlignment="Left">
              <PathIcon Data="{Binding Current.Icon}" Foreground="White" Width="26" Height="26" />
            </Border>
            <StackPanel Spacing="6">
              <TextBlock Classes="kicker" Text="{Binding Current.Kicker}" />
              <TextBlock Text="{Binding Current.Title}" FontSize="26" FontWeight="Bold" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Classes="body" FontSize="14" LineHeight="22" Text="{Binding Current.Body}" MinHeight="110" IsVisible="{Binding !Current.IsCheck}" />
            <TextBlock Classes="body" FontSize="14" LineHeight="22" Text="{Binding Current.Body}" IsVisible="{Binding Current.IsCheck}" />

            <!-- The hardware check: pick a pulse color, then say whether everything lit up. -->
            <StackPanel Spacing="14" IsVisible="{Binding Current.IsCheck}">
              <ItemsControl ItemsSource="{Binding Swatches}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FlashSwatch">
                    <Button Classes="swatch" Classes.picked="{Binding IsSelected}" Command="{Binding PickCommand}" Background="{Binding Brush}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="muted" Text="{Binding FoundText}" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Is everything pulsing?" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Button Classes="ghost" Content="Yes, all of it" Command="{Binding AnswerCommand}" CommandParameter="yes" />
                <Button Classes="ghost" Content="Something isn't" Command="{Binding AnswerCommand}" CommandParameter="no" />
              </StackPanel>
              <Border Classes="note" IsVisible="{Binding AnsweredYes}">
                <TextBlock Classes="body" Text="Great, MyRGB can reach all of it. Next, put each device where it sits on your desk." />
              </Border>
              <Border Classes="note" IsVisible="{Binding AnsweredNo}">
                <StackPanel Spacing="8">
                  <TextBlock Classes="body" Text="A few things usually explain it:" />
                  <TextBlock Classes="body" Text="• A vendor app (iCUE, Synapse, G HUB, Armoury Crate) is running and holding on to the device. Close it, then scan again on the Devices page." />
                  <TextBlock Classes="body" Text="• Fans and strips on a controller need their LED count set before they light. The Devices page asks for it." />
                  <TextBlock Classes="body" Text="• The device is off, asleep, or not supported yet. Wake it up; if it still isn't on the Devices page, MyRGB can't light it yet." />
                  <Button Classes="link" Content="Open the Devices page ›" Command="{Binding GoCommand}" CommandParameter="devices" HorizontalAlignment="Left" Margin="-6,0,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
            <Button Classes="link" Content="{Binding Current.ActionLabel, StringFormat='{}{0} ›'}" Command="{Binding GoCommand}"
                    IsVisible="{Binding Current.HasAction}" HorizontalAlignment="Left" Margin="-6,0,0,0" />
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,8,0,0">
              <TextBlock Classes="muted" Text="{Binding Progress}" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="link" Content="Skip tour" Command="{Binding SkipCommand}" HorizontalAlignment="Left" Margin="16,0,0,0" />
              <Button Grid.Column="2" Classes="ghost" Content="Back" Command="{Binding BackCommand}" IsVisible="{Binding !IsFirst}" Margin="0,0,10,0" />
              <Button Grid.Column="3" Classes="accent" Content="{Binding NextLabel}" Command="{Binding NextCommand}" MinWidth="110" HorizontalContentAlignment="Center" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
