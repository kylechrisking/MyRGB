<!-- Dark: plain and quiet, like Windows' own dark mode. What Match Windows uses at night. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://MyRGB/Themes/Defaults.axaml" />
  </ResourceDictionary.MergedDictionaries>

  <SolidColorBrush x:Key="PageBrush" Color="#202020" />
  <SolidColorBrush x:Key="BaseBrush" Color="#202020" />
  <SolidColorBrush x:Key="ChromeBrush" Color="#1C1C1C" />
  <SolidColorBrush x:Key="TopBarBrush" Color="#1C1C1C" />
  <SolidColorBrush x:Key="ChromeEdgeBrush" Color="#2E2E2E" />
  <SolidColorBrush x:Key="NavBrush" Color="Transparent" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#2B2B2B" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#323232" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#383838" />
  <SolidColorBrush x:Key="HairlineBrush" Color="#3A3A3A" />
  <SolidColorBrush x:Key="HairlineStrongBrush" Color="#505050" />
  <SolidColorBrush x:Key="OverlayBrush" Color="#99000000" />

  <SolidColorBrush x:Key="InkBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="InkSecondaryBrush" Color="#D6D6D6" />
  <SolidColorBrush x:Key="MutedBrush" Color="#A8A8A8" />
  <SolidColorBrush x:Key="SubtleBrush" Color="#7A7A7A" />
  <SolidColorBrush x:Key="HandBrush" Color="#A8A8A8" />

  <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#8ADAFF" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="#003A57" />
  <SolidColorBrush x:Key="AccentWashBrush" Color="#1F3A4A" />
  <SolidColorBrush x:Key="LinkBrush" Color="#60CDFF" />

  <SolidColorBrush x:Key="LedRedBrush" Color="#FF6B6B" />
  <SolidColorBrush x:Key="LedGreenBrush" Color="#6CCB5F" />
  <SolidColorBrush x:Key="LedBlueBrush" Color="#60CDFF" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />
  <SolidColorBrush x:Key="WarningBrush" Color="#FCE100" />
  <SolidColorBrush x:Key="DangerBrush" Color="#FF99A4" />
  <SolidColorBrush x:Key="InfoBrush" Color="#60CDFF" />
  <SolidColorBrush x:Key="InfoWashBrush" Color="#1F3340" />
  <SolidColorBrush x:Key="DangerWashBrush" Color="#442726" />

  <LinearGradientBrush x:Key="RgbGradient" StartPoint="0%,0%" EndPoint="100%,0%">
    <GradientStop Offset="0" Color="#FF5D6E" />
    <GradientStop Offset="0.5" Color="#56DB8F" />
    <GradientStop Offset="1" Color="#42A3FD" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="RgbGradientVertical" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#FF5D6E" />
    <GradientStop Offset="0.5" Color="#56DB8F" />
    <GradientStop Offset="1" Color="#42A3FD" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="NavSelectedBrush" Color="#2D2D2D" />
  <SolidColorBrush x:Key="NavSelectedEdgeBrush" Color="Transparent" />
  <SolidColorBrush x:Key="NavSelectedInkBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="NavPipeBrush" Color="#60CDFF" />
  <Thickness x:Key="NavItemMargin">8,2</Thickness>

  <SolidColorBrush x:Key="PlayBrush" Color="#60CDFF" />
  <SolidColorBrush x:Key="PlayHoverBrush" Color="#8ADAFF" />
  <SolidColorBrush x:Key="OnPlayBrush" Color="#003A57" />
  <SolidColorBrush x:Key="PlayBorderBrush" Color="Transparent" />
  <SolidColorBrush x:Key="PrimaryBrush" Color="#60CDFF" />
  <SolidColorBrush x:Key="OnPrimaryBrush" Color="#003A57" />

  <SolidColorBrush x:Key="ScreenWellBrush" Color="#111111" />
  <SolidColorBrush x:Key="BadgeBrush" Color="#333333" />
  <SolidColorBrush x:Key="BadgeBorderBrush" Color="Transparent" />
  <SolidColorBrush x:Key="IconBoxBrush" Color="#333333" />
  <SolidColorBrush x:Key="IconBoxBorderBrush" Color="Transparent" />
  <SolidColorBrush x:Key="IconBoxInkBrush" Color="#D6D6D6" />
  <SolidColorBrush x:Key="MeterTrackBrush" Color="#3A3A3A" />
  <SolidColorBrush x:Key="SupporterWashBrush" Color="#3A1426" />
  <SolidColorBrush x:Key="SupporterBrush" Color="#FF7EB6" />

  <Color x:Key="SystemAccentColor">#60CDFF</Color>
  <Color x:Key="SystemAccentColorLight1">#7AD6FF</Color>
  <Color x:Key="SystemAccentColorLight2">#99E0FF</Color>
  <Color x:Key="SystemAccentColorLight3">#B8EAFF</Color>
  <Color x:Key="SystemAccentColorDark1">#4CB8EB</Color>
  <Color x:Key="SystemAccentColorDark2">#3AA0D0</Color>
  <Color x:Key="SystemAccentColorDark3">#2A86B3</Color>

  <CornerRadius x:Key="RadiusPanel">8</CornerRadius>
  <CornerRadius x:Key="RadiusTile">8</CornerRadius>
  <CornerRadius x:Key="RadiusControl">4</CornerRadius>
  <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
  <CornerRadius x:Key="RadiusBadge">4</CornerRadius>
  <CornerRadius x:Key="RadiusIconBox">6</CornerRadius>
  <CornerRadius x:Key="RadiusNav">4</CornerRadius>
  <CornerRadius x:Key="RadiusDialog">8</CornerRadius>
  <sys:Double x:Key="DialogStripe">0</sys:Double>
  <sys:Double x:Key="RadiusPreview">4</sys:Double>

  <FontFamily x:Key="BrandSans">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="BrandDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="BrandMono">Cascadia Mono, Consolas</FontFamily>
  <FontFamily x:Key="KickerFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="NumberFont">Segoe UI Variable Display, Segoe UI</FontFamily>
  <sys:Double x:Key="H1Size">28</sys:Double>
  <sys:Double x:Key="SectionSize">16</sys:Double>
  <sys:Double x:Key="WordmarkSize">18</sys:Double>
  <sys:Double x:Key="KickerSize">12</sys:Double>
  <sys:Double x:Key="KickerSpacing">0</sys:Double>
</ResourceDictionary>
