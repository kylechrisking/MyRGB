<!-- Bench: a bare circuit board. Black solder mask with a faint grid, silkscreen white, copper links, square edges. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://MyRGB/Themes/Defaults.axaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- The board, with a 24 px grid etched into it. -->
  <DrawingBrush x:Key="PageBrush" TileMode="Tile" DestinationRect="0,0,24,24" Stretch="None">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#0C0F0D" Geometry="M0,0 H24 V24 H0 Z" />
        <GeometryDrawing Brush="#141915" Geometry="M23,0 H24 V24 H23 Z M0,23 H24 V24 H0 Z" />
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <SolidColorBrush x:Key="BaseBrush" Color="#0C0F0D" />
  <SolidColorBrush x:Key="ChromeBrush" Color="#0A0C0B" />
  <SolidColorBrush x:Key="TopBarBrush" Color="#0A0C0B" />
  <SolidColorBrush x:Key="ChromeEdgeBrush" Color="#3A413C" />
  <SolidColorBrush x:Key="NavBrush" Color="#0A0C0B" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#0E120F" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#121713" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#18201B" />
  <SolidColorBrush x:Key="HairlineBrush" Color="#3A413C" />
  <SolidColorBrush x:Key="HairlineStrongBrush" Color="#5A625C" />
  <SolidColorBrush x:Key="OverlayBrush" Color="#CC050605" />

  <!-- Silkscreen. -->
  <SolidColorBrush x:Key="InkBrush" Color="#E9E6DC" />
  <SolidColorBrush x:Key="InkSecondaryBrush" Color="#C5C2B8" />
  <SolidColorBrush x:Key="MutedBrush" Color="#8F948C" />
  <SolidColorBrush x:Key="SubtleBrush" Color="#5E645F" />
  <SolidColorBrush x:Key="HandBrush" Color="#8F948C" />

  <!-- A lit green LED for switches, copper for anything you can follow. -->
  <SolidColorBrush x:Key="AccentBrush" Color="#3FE08A" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#7AF0B0" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="#05140B" />
  <SolidColorBrush x:Key="AccentWashBrush" Color="#13201A" />
  <SolidColorBrush x:Key="LinkBrush" Color="#C98B4A" />

  <SolidColorBrush x:Key="LedRedBrush" Color="#FF4D5E" />
  <SolidColorBrush x:Key="LedGreenBrush" Color="#3FE08A" />
  <SolidColorBrush x:Key="LedBlueBrush" Color="#3A9BFF" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#3FE08A" />
  <SolidColorBrush x:Key="WarningBrush" Color="#FFB03A" />
  <SolidColorBrush x:Key="DangerBrush" Color="#FF4D5E" />
  <SolidColorBrush x:Key="InfoBrush" Color="#3A9BFF" />
  <SolidColorBrush x:Key="InfoWashBrush" Color="#10202E" />
  <SolidColorBrush x:Key="DangerWashBrush" Color="#2A1214" />

  <LinearGradientBrush x:Key="RgbGradient" StartPoint="0%,0%" EndPoint="100%,0%">
    <GradientStop Offset="0" Color="#FF4D5E" />
    <GradientStop Offset="0.5" Color="#3FE08A" />
    <GradientStop Offset="1" Color="#3A9BFF" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="RgbGradientVertical" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#FF4D5E" />
    <GradientStop Offset="0.5" Color="#3FE08A" />
    <GradientStop Offset="1" Color="#3A9BFF" />
  </LinearGradientBrush>

  <!-- The selected page: solder-mask green with a gold pad. -->
  <SolidColorBrush x:Key="NavSelectedBrush" Color="#13201A" />
  <SolidColorBrush x:Key="NavSelectedEdgeBrush" Color="Transparent" />
  <SolidColorBrush x:Key="NavSelectedInkBrush" Color="#E9E6DC" />
  <SolidColorBrush x:Key="NavPipeBrush" Color="#D8B45C" />
  <Thickness x:Key="NavItemMargin">0,1</Thickness>

  <SolidColorBrush x:Key="PlayBrush" Color="#E9E6DC" />
  <SolidColorBrush x:Key="PlayHoverBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="OnPlayBrush" Color="#0C0F0D" />
  <SolidColorBrush x:Key="PlayBorderBrush" Color="Transparent" />
  <SolidColorBrush x:Key="PrimaryBrush" Color="Transparent" />
  <SolidColorBrush x:Key="OnPrimaryBrush" Color="#C98B4A" />

  <SolidColorBrush x:Key="ScreenWellBrush" Color="#000000" />
  <SolidColorBrush x:Key="BadgeBrush" Color="Transparent" />
  <SolidColorBrush x:Key="BadgeBorderBrush" Color="#3A413C" />
  <Thickness x:Key="BadgeBorder">1</Thickness>
  <SolidColorBrush x:Key="IconBoxBrush" Color="Transparent" />
  <SolidColorBrush x:Key="IconBoxBorderBrush" Color="#3A413C" />
  <Thickness x:Key="IconBoxBorder">1</Thickness>
  <SolidColorBrush x:Key="IconBoxInkBrush" Color="#E9E6DC" />
  <SolidColorBrush x:Key="MeterTrackBrush" Color="#1A201C" />
  <SolidColorBrush x:Key="SupporterWashBrush" Color="#2A1222" />
  <SolidColorBrush x:Key="SupporterBrush" Color="#FF7EB6" />

  <Color x:Key="SystemAccentColor">#3FE08A</Color>
  <Color x:Key="SystemAccentColorLight1">#5CE79E</Color>
  <Color x:Key="SystemAccentColorLight2">#7AF0B0</Color>
  <Color x:Key="SystemAccentColorLight3">#A4F6CA</Color>
  <Color x:Key="SystemAccentColorDark1">#32BA72</Color>
  <Color x:Key="SystemAccentColorDark2">#28955B</Color>
  <Color x:Key="SystemAccentColorDark3">#1E7045</Color>

  <!-- Nothing on a board is rounded. -->
  <CornerRadius x:Key="RadiusPanel">0</CornerRadius>
  <CornerRadius x:Key="RadiusTile">0</CornerRadius>
  <CornerRadius x:Key="RadiusControl">0</CornerRadius>
  <CornerRadius x:Key="RadiusSmall">0</CornerRadius>
  <CornerRadius x:Key="RadiusBadge">0</CornerRadius>
  <CornerRadius x:Key="RadiusIconBox">0</CornerRadius>
  <CornerRadius x:Key="RadiusNav">0</CornerRadius>
  <CornerRadius x:Key="RadiusMeter">0</CornerRadius>
  <CornerRadius x:Key="RadiusPlay">0</CornerRadius>
  <CornerRadius x:Key="RadiusAvatar">0</CornerRadius>
  <CornerRadius x:Key="RadiusDialog">0</CornerRadius>
  <CornerRadius x:Key="RadiusPill">0</CornerRadius>
  <sys:Double x:Key="RadiusPreview">0</sys:Double>
  <sys:Double x:Key="DialogStripe">2</sys:Double>

  <FontFamily x:Key="BrandSans">Segoe UI</FontFamily>
  <FontFamily x:Key="BrandDisplay">Bahnschrift</FontFamily>
  <FontFamily x:Key="BrandMono">Consolas</FontFamily>
  <FontFamily x:Key="KickerFont">Consolas</FontFamily>
  <FontFamily x:Key="NumberFont">Bahnschrift</FontFamily>
  <sys:Double x:Key="H1Size">30</sys:Double>
  <sys:Double x:Key="SectionSize">16</sys:Double>
  <sys:Double x:Key="WordmarkSize">19</sys:Double>
  <sys:Double x:Key="KickerSize">11</sys:Double>
  <sys:Double x:Key="KickerSpacing">0.4</sys:Double>
  <sys:Boolean x:Key="NavIconsVisible">True</sys:Boolean>
</ResourceDictionary>
