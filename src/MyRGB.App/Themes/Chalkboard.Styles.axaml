<!-- Chalkboard's shape: chalk-outlined buttons, chalk headings, soft shadows like a board in a dim room. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.panel, Border.tile, Border.alert">
    <Setter Property="BoxShadow" Value="0 4 10 -6 #80000000" />
  </Style>
  <Style Selector="Border.dialog">
    <Setter Property="BorderBrush" Value="#ECEAE0" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>
  <Style Selector="TextBlock.h1, TextBlock.section, TextBlock.wordmark">
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="#CFCDC2" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#3C4740" />
    <Setter Property="BorderBrush" Value="#ECEAE0" />
  </Style>
  <Style Selector="TabControl.nav > TabItem">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Padding" Value="26,0,14,0" />
    <Setter Property="MinHeight" Value="38" />
  </Style>
  <!-- Chalk headings sit low; give them room. -->
  <Style Selector="TextBlock.h1">
    <Setter Property="Margin" Value="0,0,0,2" />
  </Style>
</Styles>
