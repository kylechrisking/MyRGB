<!-- Notebook: cream ruled paper, ink, Georgia headings, a handwritten aside here and there. The default from 0.5.2. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://MyRGB/Themes/Defaults.axaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Paper with faint blue rules, 28 px apart. -->
  <DrawingBrush x:Key="PageBrush" TileMode="Tile" DestinationRect="0,0,64,28" Stretch="None">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#F1EBDD" Geometry="M0,0 H64 V28 H0 Z" />
        <GeometryDrawing Brush="#D3DCE3" Geometry="M0,27 H64 V28 H0 Z" />
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <SolidColorBrush x:Key="BaseBrush" Color="#F1EBDD" />
  <SolidColorBrush x:Key="ChromeBrush" Color="#E9E1CF" />
  <SolidColorBrush x:Key="TopBarBrush" Color="#F1EBDD" />
  <SolidColorBrush x:Key="ChromeEdgeBrush" Color="#22201C" />
  <SolidColorBrush x:Key="NavBrush" Color="#E9E1CF" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FBF8F0" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFDF8" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#EFE8D8" />
  <SolidColorBrush x:Key="HairlineBrush" Color="#D9CFB9" />
  <SolidColorBrush x:Key="HairlineStrongBrush" Color="#B5A98F" />
  <SolidColorBrush x:Key="OverlayBrush" Color="#8C2A2620" />

  <SolidColorBrush x:Key="InkBrush" Color="#22201C" />
  <SolidColorBrush x:Key="InkSecondaryBrush" Color="#45413A" />
  <SolidColorBrush x:Key="MutedBrush" Color="#6E675C" />
  <SolidColorBrush x:Key="SubtleBrush" Color="#9A9284" />
  <SolidColorBrush x:Key="HandBrush" Color="#5B5448" />

  <!-- Blue ink for links and switches, red for the margin. -->
  <SolidColorBrush x:Key="AccentBrush" Color="#2F5FC4" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#23499A" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="AccentWashBrush" Color="#E4E9F4" />
  <SolidColorBrush x:Key="LinkBrush" Color="#2F5FC4" />

  <SolidColorBrush x:Key="LedRedBrush" Color="#D8344A" />
  <SolidColorBrush x:Key="LedGreenBrush" Color="#2A9254" />
  <SolidColorBrush x:Key="LedBlueBrush" Color="#2F6FD6" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#2A8A4E" />
  <SolidColorBrush x:Key="WarningBrush" Color="#B86E00" />
  <SolidColorBrush x:Key="DangerBrush" Color="#C8323C" />
  <SolidColorBrush x:Key="InfoBrush" Color="#2F6FD6" />
  <SolidColorBrush x:Key="InfoWashBrush" Color="#E6ECF6" />
  <SolidColorBrush x:Key="DangerWashBrush" Color="#F8E2DF" />

  <!-- The RGB gradient stays: it means "light". -->
  <LinearGradientBrush x:Key="RgbGradient" StartPoint="0%,0%" EndPoint="100%,0%">
    <GradientStop Offset="0" Color="#F2445A" />
    <GradientStop Offset="0.25" Color="#F59B2E" />
    <GradientStop Offset="0.5" Color="#3CC274" />
    <GradientStop Offset="0.75" Color="#20BFD0" />
    <GradientStop Offset="1" Color="#3A86F0" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="RgbGradientVertical" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#F2445A" />
    <GradientStop Offset="0.25" Color="#F59B2E" />
    <GradientStop Offset="0.5" Color="#3CC274" />
    <GradientStop Offset="0.75" Color="#20BFD0" />
    <GradientStop Offset="1" Color="#3A86F0" />
  </LinearGradientBrush>

  <!-- The selected page is a tab of the same paper, ruled off in ink, with a red margin mark. -->
  <SolidColorBrush x:Key="NavSelectedBrush" Color="#F1EBDD" />
  <SolidColorBrush x:Key="NavSelectedEdgeBrush" Color="#22201C" />
  <SolidColorBrush x:Key="NavSelectedInkBrush" Color="#22201C" />
  <SolidColorBrush x:Key="NavPipeBrush" Color="#D8344A" />
  <Thickness x:Key="NavSelectedEdge">0,2,0,2</Thickness>
  <Thickness x:Key="NavItemMargin">0,1</Thickness>

  <SolidColorBrush x:Key="PlayBrush" Color="#FBF8F0" />
  <SolidColorBrush x:Key="PlayHoverBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="OnPlayBrush" Color="#22201C" />
  <SolidColorBrush x:Key="PlayBorderBrush" Color="#22201C" />
  <Thickness x:Key="PlayBorderThickness">2</Thickness>
  <SolidColorBrush x:Key="PrimaryBrush" Color="#22201C" />
  <SolidColorBrush x:Key="OnPrimaryBrush" Color="#F6F1E6" />

  <SolidColorBrush x:Key="ScreenWellBrush" Color="#1E1C19" />
  <SolidColorBrush x:Key="BadgeBrush" Color="Transparent" />
  <SolidColorBrush x:Key="BadgeBorderBrush" Color="#9A9284" />
  <Thickness x:Key="BadgeBorder">1</Thickness>
  <SolidColorBrush x:Key="IconBoxBrush" Color="Transparent" />
  <SolidColorBrush x:Key="IconBoxBorderBrush" Color="#22201C" />
  <Thickness x:Key="IconBoxBorder">1.5</Thickness>
  <SolidColorBrush x:Key="IconBoxInkBrush" Color="#22201C" />
  <SolidColorBrush x:Key="MeterTrackBrush" Color="#E4DCCA" />
  <SolidColorBrush x:Key="SupporterWashBrush" Color="#FBE3EE" />
  <SolidColorBrush x:Key="SupporterBrush" Color="#B4236A" />

  <!-- Fluent's own accent (toggles, sliders, focus). -->
  <Color x:Key="SystemAccentColor">#2F5FC4</Color>
  <Color x:Key="SystemAccentColorLight1">#4A76D2</Color>
  <Color x:Key="SystemAccentColorLight2">#6A8FDC</Color>
  <Color x:Key="SystemAccentColorLight3">#8EAAE6</Color>
  <Color x:Key="SystemAccentColorDark1">#2A55B0</Color>
  <Color x:Key="SystemAccentColorDark2">#23499A</Color>
  <Color x:Key="SystemAccentColorDark3">#1C3C80</Color>

  <!-- Paper doesn't need rounded plastic. -->
  <CornerRadius x:Key="RadiusPanel">2</CornerRadius>
  <CornerRadius x:Key="RadiusTile">2</CornerRadius>
  <CornerRadius x:Key="RadiusControl">4</CornerRadius>
  <CornerRadius x:Key="RadiusSmall">3</CornerRadius>
  <CornerRadius x:Key="RadiusBadge">10</CornerRadius>
  <CornerRadius x:Key="RadiusIconBox">19</CornerRadius>
  <CornerRadius x:Key="RadiusNav">0</CornerRadius>
  <CornerRadius x:Key="RadiusMeter">0</CornerRadius>
  <CornerRadius x:Key="RadiusDialog">3</CornerRadius>
  <Thickness x:Key="TopBarEdge">0,0,0,2</Thickness>
  <Thickness x:Key="PlayerBarEdge">0,2,0,0</Thickness>
  <sys:Double x:Key="DialogStripe">0</sys:Double>
  <sys:Double x:Key="RadiusPreview">2</sys:Double>

  <FontFamily x:Key="BrandSans">Segoe UI</FontFamily>
  <FontFamily x:Key="BrandDisplay">Georgia</FontFamily>
  <FontFamily x:Key="BrandMono">Consolas</FontFamily>
  <FontFamily x:Key="KickerFont">Segoe UI</FontFamily>
  <FontFamily x:Key="NumberFont">Georgia</FontFamily>
  <sys:Double x:Key="H1Size">32</sys:Double>
  <sys:Double x:Key="SectionSize">18</sys:Double>
  <sys:Double x:Key="WordmarkSize">24</sys:Double>
  <sys:Double x:Key="KickerSize">12</sys:Double>
  <sys:Double x:Key="KickerSpacing">0</sys:Double>
  <sys:Boolean x:Key="HandVisible">True</sys:Boolean>
  <sys:Boolean x:Key="NavIconsVisible">False</sys:Boolean>
  <sys:Boolean x:Key="MarkVisible">False</sys:Boolean>

  <!-- Tick boxes for the on/off switches. -->
  <SolidColorBrush x:Key="ToggleBoxBrush" Color="#FFFDF8" />
  <SolidColorBrush x:Key="ToggleBoxBorderBrush" Color="#22201C" />
  <SolidColorBrush x:Key="ToggleTickBrush" Color="#2A8A4E" />
  <Thickness x:Key="ToggleBoxBorder">1.5</Thickness>
  <CornerRadius x:Key="ToggleBoxRadius">2</CornerRadius>
  <!-- Which switch shape shows (Toggles.axaml). -->
  <sys:Boolean x:Key="TogglePillVisible">False</sys:Boolean>
  <sys:Boolean x:Key="ToggleBoxVisible">True</sys:Boolean>
</ResourceDictionary>
