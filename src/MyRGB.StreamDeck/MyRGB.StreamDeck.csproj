    <!-- WinExe so Stream Deck never flashes a console window when it launches the plugin. -->
    <OutputType>WinExe</OutputType>
    <RootNamespace>MyRGB.StreamDeck</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
